@startuml SALUD_Pay_Module_80_pay_webhooks
title Module 80 — pay-webhooks: Endpoints, secretos y entregas de webhooks\n(schema: pay_webhooks)
skinparam shadowing false
skinparam linetype ortho
skinparam packageStyle rectangle
hide circle

' ------------------------------------------------------------------------------
' PERFIL PAY (D-18). Una base de PostgreSQL POR SERVICIO: este módulo describe la base `pay_webhooks`,
' no un schema de la base de SALUD. Se genera con salud-db/gen_ddl_pay.py a SQL/pay/80_pay_webhooks/ (objetos sin
' calificar: se crean en el esquema de la conexión). Portado el 2026-10-27 del DDL de referencia de
' services/pay-webhooks/sql/ (pasarelapago). A partir de acá la fuente de verdad es ESTE archivo.
' SQL de referencia de pay-webhooks (a mover a mantra-core-health-model, D-18).
' pay-webhooks es dueño de los endpoints de los comercios, de sus secretos de firma y de las entregas de eventos públicos.
' Los secretos NUNCA se guardan en claro: `sealed_secret` es AES-256-GCM con la clave de cifrado del servicio.
' ------------------------------------------------------------------------------
note as BIZ_diagram_80_pay_webhooks
  BUSINESS PURPOSE
  Base propia del microservicio pay-webhooks de la pasarela de pagos ALOVIDA (endpoints, secretos y entregas de webhooks).
  Separación (regla #1 del plan maestro): ningún otro servicio lee estas tablas; los datos de otros
  servicios llegan por eventos o por sus APIs. Dinero en unidades menores enteras (amount_minor, BOB).
end note

entity webhook_endpoints {
  * id : text <<PK>>
  * merchant_id : text
  * url : text
    description : text
  * enabled_events : text[]
  * signature_scheme : text
  * status : text
    disabled_reason : text
  ' entregas agotadas seguidas; una entrega correcta lo vuelve a cero. Al llegar al tope el endpoint se deshabilita.
  * consecutive_failures : integer
  * created_at : timestamptz
  * updated_at : timestamptz
    deleted_at : timestamptz
}

' Una fila por versión del secreto. Durante una rotación conviven dos: la nueva (expires_at NULL) y la vieja con su gracia.
entity webhook_secrets {
  * endpoint_id : text <<PK, FK>>
  * version : integer <<PK>>
  ' `whsec_…` (v1) o `whsk_…` (v1a), sellado con AES-256-GCM: `v1.<iv>.<tag>.<texto cifrado>` en base64url.
  * sealed_secret : text
  ' `whpk_…` solo para v1a: es lo que el comercio verifica.
    public_key : text
  * created_at : timestamptz
  ' último instante en que todavía se firma con esta versión; NULL = vigente sin vencimiento.
    expires_at : timestamptz
}

entity webhook_deliveries {
  * id : text <<PK>>
  * endpoint_id : text <<FK>>
  * merchant_id : text
  ' `id` del CloudEvent: es también el `webhook-id` que ve el comercio, igual en todos los reintentos.
  * event_id : text
  * event_type : text
  ' cuerpo JSON exacto que se firma y se envía (texto, no jsonb: los bytes no cambian entre reintentos).
  * payload : text
  * status : text
  * attempts : integer
  * next_attempt_at : timestamptz
    last_status : integer
    last_error : text
  * created_at : timestamptz
    delivered_at : timestamptz
}

' Historial de intentos: sin cuerpos ni mensajes de error de la red, solo códigos.
entity webhook_delivery_attempts {
  * delivery_id : text <<PK, FK>>
  * attempt : integer <<PK>>
  * attempted_at : timestamptz
    status_code : integer
    error_code : text
  * duration_ms : integer
}

' Inbox de @pay/outbox: un evento, un efecto.
' Tabla técnica de @pay/outbox: la declara la librería y cada servicio la tiene en SU base.
entity inbox_events {
  * consumer : text <<PK>>
  * event_id : text <<PK>>
  * processed_at : timestamptz
}

' Tabla técnica de @pay/idempotency. Cada servicio la tiene en SU base (regla de separación #1).
' Se declara en el modelo (mantra-core-health-model, D-18) y se aplica por el pipeline; este archivo es la referencia.
' Tabla técnica de @pay/idempotency: la declara la librería y cada servicio la tiene en SU base.
entity idempotency_keys {
  ' quién: el id del comercio
  * scope : text <<PK>>
  ' la Idempotency-Key del cliente
  * key : text <<PK>>
  ' sha256 de método + ruta + cuerpo canónico
  * request_hash : text
  * state : text
  ' hasta dónde llegó la ejecución
  * recovery_point : text
    response_status : integer
    response_body : jsonb
  ' null = nadie la está ejecutando
    locked_at : timestamptz
  ' identifica a quien la ejecuta (compare-and-set)
    lock_token : text
  * created_at : timestamptz
  * expires_at : timestamptz
}

webhook_secrets }o--|| webhook_endpoints : endpoint_id
webhook_deliveries }o--|| webhook_endpoints : endpoint_id
webhook_delivery_attempts }o--|| webhook_deliveries : delivery_id

entity "INDEXES · webhook_endpoints" as idxset_webhook_endpoints <<INDEX_SET>> {
  PK pk_webhook_endpoints : (id) UNIQUE BTREE
  IX webhook_endpoints_merchant_idx : (merchant_id, created_at DESC, id DESC) BTREE WHERE deleted_at IS NULL
}
webhook_endpoints .. idxset_webhook_endpoints : indexed by

entity "INDEXES · webhook_secrets" as idxset_webhook_secrets <<INDEX_SET>> {
  PK pk_webhook_secrets : (endpoint_id, version) UNIQUE BTREE
}
webhook_secrets .. idxset_webhook_secrets : indexed by

entity "INDEXES · webhook_deliveries" as idxset_webhook_deliveries <<INDEX_SET>> {
  PK pk_webhook_deliveries : (id) UNIQUE BTREE
  UK webhook_deliveries_endpoint_event_key : (endpoint_id, event_id) UNIQUE BTREE
  IX webhook_deliveries_due_idx : (next_attempt_at) BTREE WHERE status = 'pending'
}
webhook_deliveries .. idxset_webhook_deliveries : indexed by

entity "INDEXES · webhook_delivery_attempts" as idxset_webhook_delivery_attempts <<INDEX_SET>> {
  PK pk_webhook_delivery_attempts : (delivery_id, attempt) UNIQUE BTREE
}
webhook_delivery_attempts .. idxset_webhook_delivery_attempts : indexed by

entity "INDEXES · inbox_events" as idxset_inbox_events <<INDEX_SET>> {
  PK pk_inbox_events : (consumer, event_id) UNIQUE BTREE
}
inbox_events .. idxset_inbox_events : indexed by

entity "INDEXES · idempotency_keys" as idxset_idempotency_keys <<INDEX_SET>> {
  PK pk_idempotency_keys : (scope, key) UNIQUE BTREE
  IX idempotency_keys_expires_at_idx : (expires_at) BTREE
}
idempotency_keys .. idxset_idempotency_keys : indexed by

entity "PAY EXTRAS · pay_webhooks" as pay_extras_pay_webhooks <<PAY_EXTRAS>> {
  ' Lo que el generador base (gen_ddl.py) no expresa: defaults no booleanos, identidades, CHECK, FK compuestas,
  ' funciones, triggers y datos semilla. Lo materializa salud-db/gen_ddl_pay.py (05_constraints.sql / 06_seed.sql).
  DEFAULT webhook_endpoints.signature_scheme : 'v1'
  DEFAULT webhook_endpoints.status : 'enabled'
  DEFAULT webhook_endpoints.consecutive_failures : 0
  DEFAULT webhook_endpoints.created_at : now()
  DEFAULT webhook_endpoints.updated_at : now()
  CHECK_SQL webhook_endpoints : webhook_endpoints_id_check | id ~ '^we_[a-z0-9]{10,40}$'
  CHECK_SQL webhook_endpoints : webhook_endpoints_events_check | cardinality(enabled_events) >= 1
  CHECK_SQL webhook_endpoints : webhook_endpoints_scheme_check | signature_scheme IN ('v1', 'v1a')
  CHECK_SQL webhook_endpoints : webhook_endpoints_status_check | status IN ('enabled', 'disabled')
  CHECK_SQL webhook_endpoints : webhook_endpoints_reason_check | disabled_reason IS NULL OR disabled_reason IN ('gone_410', 'too_many_failures', 'manual')
  CHECK_SQL webhook_endpoints : webhook_endpoints_reason_status_check | (status = 'disabled') = (disabled_reason IS NOT NULL)
  DEFAULT webhook_secrets.created_at : now()
  DEFAULT webhook_deliveries.status : 'pending'
  DEFAULT webhook_deliveries.attempts : 0
  DEFAULT webhook_deliveries.created_at : now()
  CHECK_SQL webhook_deliveries : webhook_deliveries_status_check | status IN ('pending', 'succeeded', 'dead')
  DEFAULT inbox_events.processed_at : now()
  DEFAULT idempotency_keys.recovery_point : 'started'
  DEFAULT idempotency_keys.created_at : now()
  CHECK_SQL idempotency_keys : idempotency_keys_state_check | state IN ('started', 'completed')
  FUNCTION forbid_mutation
  | CREATE OR REPLACE FUNCTION forbid_mutation() RETURNS trigger LANGUAGE plpgsql AS $$
  | BEGIN
  |   RAISE EXCEPTION 'la tabla % es inmutable (%)', TG_TABLE_NAME, TG_OP USING ERRCODE = 'integrity_constraint_violation';
  | END;
  | $$
  ' Un intento de entrega es un hecho ya ocurrido: delivery.worker.ts solo hace INSERT … ON CONFLICT DO NOTHING (el estado que cambia vive en webhook_deliveries, que SÍ se actualiza y
  ' NO se guarda). No hay UPDATE/DELETE/TRUNCATE sobre esta tabla en services/*/src; las pruebas la vacían dentro de una transacción que apaga SOLO este trigger (ver test/harness.ts).
  TRIGGER webhook_delivery_attempts_immutable : BEFORE UPDATE OR DELETE ON webhook_delivery_attempts FOR EACH ROW EXECUTE FUNCTION forbid_mutation()
  TRIGGER webhook_delivery_attempts_no_truncate : BEFORE TRUNCATE ON webhook_delivery_attempts FOR EACH STATEMENT EXECUTE FUNCTION forbid_mutation()
}

@enduml
