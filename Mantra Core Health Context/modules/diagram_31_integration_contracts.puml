  * status_concept_id : uuid <<FK>>
  * created_at : timestamptz
  * updated_at : timestamptz
    created_by_user_id : uuid <<FK>>
    updated_by_user_id : uuid <<FK>>
  * row_version : integer
}

entity integration_exchange_records <<APPEND_ONLY>> {
  * id : uuid <<PK>>
  --
  * integration_contract_version_id : uuid <<FK>>
  * direction_concept_id : uuid <<FK>>
  * message_type_concept_id : uuid <<FK>>
    business_identifier : varchar
    idempotency_key : varchar
    correlation_id : uuid
    subject_type_concept_id : uuid <<FK>>
    subject_entity_id : uuid
