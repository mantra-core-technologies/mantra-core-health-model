    response_hash : varchar
    payload_file_id : uuid <<FK>>
    received_at : timestamptz
    completed_at : timestamptz
  * outcome_concept_id : uuid <<FK>>
  * created_at : timestamptz
}

entity integration_exchange_attempts <<LOG>> {
  * id : uuid <<PK>>
  --
  * integration_exchange_record_id : uuid <<FK>>
  * attempt_number : integer
    endpoint_id : uuid <<FK>>
    started_at : timestamptz
    completed_at : timestamptz
