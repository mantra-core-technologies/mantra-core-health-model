note as BIZ_diagram_31_integration_contracts
  BUSINESS PURPOSE
  Supports ministries, government data centers, insurers, pharmacies,
  diagnostic units and other external systems through versioned contracts,
  sender-constrained authentication, idempotency and complete exchange evidence.
end note

entity integration_contracts {
  * id : uuid <<PK>>
  --
  * external_provider_id : uuid <<FK>>
  * contract_code : varchar
  * capability_concept_id : uuid <<FK>>
    data_classification_concept_id : uuid <<FK>>
    legal_basis_concept_id : uuid <<FK>>
    allowed_purpose_value_set_id : uuid <<FK>>
    data_use_agreement_id : uuid <<FK>>
  * status_concept_id : uuid <<FK>>
  * created_at : timestamptz
  * updated_at : timestamptz
    created_by_user_id : uuid <<FK>>
    updated_by_user_id : uuid <<FK>>
  * row_version : integer
}

entity integration_contract_versions {
  * id : uuid <<PK>>
  --
  * integration_contract_id : uuid <<FK>>
  * version_number : integer
    request_schema_file_id : uuid <<FK>>
    response_schema_file_id : uuid <<FK>>
    openapi_file_id : uuid <<FK>>
    mapping_profile_id : uuid <<FK>>
    effective_from : timestamptz
    effective_to : timestamptz
    contract_hash : varchar
  * status_concept_id : uuid <<FK>>
  * created_at : timestamptz
    created_by_user_id : uuid <<FK>>
}

entity integration_auth_profiles {
  * id : uuid <<PK>>
  --
  * integration_contract_id : uuid <<FK>>
  * auth_profile_concept_id : uuid <<FK>>
    oauth_issuer_uri : text
    client_identifier : varchar
    credential_secret_reference : text
    token_binding_concept_id : uuid <<FK>>
    mtls_certificate_reference : text
    dpop_key_reference : text
