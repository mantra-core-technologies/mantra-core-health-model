    provider_error_code : varchar
    retry_decision_concept_id : uuid <<FK>>
    next_retry_at : timestamptz
    trace_id : varchar
  * outcome_concept_id : uuid <<FK>>
  * created_at : timestamptz
}

entity integration_idempotency_records {
  * id : uuid <<PK>>
  --
  * integration_contract_id : uuid <<FK>>
  * idempotency_key : varchar
  * operation_concept_id : uuid <<FK>>
    request_hash : varchar
    first_exchange_record_id : uuid <<FK>>
    response_reference : varchar
    expires_at : timestamptz
  * status_concept_id : uuid <<FK>>
  * created_at : timestamptz
}

entity integration_sync_cursors {
  * id : uuid <<PK>>
