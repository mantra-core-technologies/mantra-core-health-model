  * integration_contract_id : uuid <<FK>>
  * event_type_concept_id : uuid <<FK>>
    callback_uri : text
    signing_key_reference : text
    secret_reference : text
    valid_from : timestamptz
    valid_to : timestamptz
  * status_concept_id : uuid <<FK>>
  * created_at : timestamptz
  * updated_at : timestamptz
    created_by_user_id : uuid <<FK>>
    updated_by_user_id : uuid <<FK>>
  * row_version : integer
}

entity webhook_delivery_evidence <<LOG>> {
  * id : uuid <<PK>>
