@startuml SALUD_Module_31_integration_contracts
title Module 31 — Governed Backend-to-Backend Contracts\n(schema: integration_contracts)
skinparam shadowing false
skinparam linetype ortho
skinparam packageStyle rectangle
hide circle

' ------------------------------------------------------------------------------
' SOURCE CONSOLIDATED: diagram_31_integration_contracts.puml
