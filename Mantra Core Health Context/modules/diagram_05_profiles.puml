entity practitioner_affiliations {
  * id : uuid <<PK>>
  --
  * practitioner_profile_id : uuid <<FK>>
  * organization_name : varchar
    practice_site_id : uuid <<FK>>
  ' + v4.1.9 — la institución como concepto del padrón oficial. Apunta a los 503
  ' establecimientos de VS_BO_HEALTH_FACILITY, conjunto que NO siembra el paquete
  ' del modelo: lo publica la API al arrancar (`bolivia-facilities-seed.service.ts`),
  ' un solo dueño, como VS_BO_OCCUPATION en `persons`. CONVIVE con
  ' `organization_name` y no lo reemplaza: el padrón es de Santa Cruz y la mayoría
  ' de los lugares donde alguien trabajó no están en él. Nullable y SIN migración
  ' por parecido de nombre —se probó: «Hospital Obrero N.º 1» da 9 candidatos y
  ' dos de las tres filas vivas son de La Paz—; se llena hacia adelante.
    health_facility_concept_id : uuid <<FK>>
  ' v4.2.6 — deja de ser obligatorio (ALV-007): un vinculo de "atiende en su
  ' propio consultorio" no tiene cargo dentro de una jerarquia, y exigirlo
  ' bloqueaba el guardado. Si existe, se usa en perfil/trayectoria; vacio no
  ' dibuja hueco.
    role_title : varchar
    department_text : varchar
    affiliation_type_concept_id : uuid <<FK>>
  * start_date : date
    end_date : date
  ' v4.1.9 — `status_concept_id` deja de ser el estado del REGISTRO y pasa a ser
  ' el de la APROBACIÓN del vínculo: pendiente · declarado · aprobado · rechazado
  ' · revocado (conjunto `practitioner-affiliation-status`, dueño la API). La
  ' vigencia laboral la sigue diciendo `end_date`.
  * status_concept_id : uuid <<FK>>
  ' + v4.1.9 — por qué se rechazó o se revocó, escrito por quien decidió y leído
  ' por el profesional: un rechazo sin motivo es mudo para quien lo recibe. Texto
  ' libre a propósito —categorizar motivos que ninguna organización pidió sería
  ' inventarlos—; el tope de 500 vive en el DTO, como el resto del módulo.
    decision_reason_text : varchar
  * created_at : timestamptz
  * updated_at : timestamptz
    created_by_user_id : uuid <<FK>>
    updated_by_user_id : uuid <<FK>>
  * row_version : integer
}

