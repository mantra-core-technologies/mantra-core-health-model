@startuml SALUD_Module_12_integrations
title Module 12 — External Connectivity and Messaging\n(schema: integrations)
skinparam shadowing false
skinparam linetype ortho
skinparam packageStyle rectangle
hide circle

' ------------------------------------------------------------------------------
' SOURCE CONSOLIDATED: diagram_12_integrations.puml
' ------------------------------------------------------------------------------
note as BIZ_diagram_12_integrations
  BUSINESS PURPOSE
  The foundation to connect with external providers — labs, insurers,
  pharmacies, government registries, payment and messaging services —
  recording every request, response and retry, all versioned for
  reliability and audit.
end note

entity external_providers {
  * id : uuid <<PK>>
  --
  * code : varchar <<UK>>
  * name : varchar
  * provider_type_concept_id : uuid <<FK>>
    base_url : text
    auth_type_concept_id : uuid <<FK>>
    doc_url : text
  * state_concept_id : uuid <<FK>>
  * created_at : timestamptz
  * updated_at : timestamptz
    created_by_user_id : uuid <<FK>>
    updated_by_user_id : uuid <<FK>>
  * row_version : integer
}
entity provider_connections {
  * id : uuid <<PK>>
  --
  * provider_id : uuid <<FK>>
  * tenant_id : uuid <<FK>>
    environment_concept_id : uuid <<FK>>
    config_json : jsonb
    credential_id : uuid <<FK>>
  * state_concept_id : uuid <<FK>>
    valid_from : timestamptz
    valid_to : timestamptz
  * created_at : timestamptz
  * updated_at : timestamptz
    created_by_user_id : uuid <<FK>>
    updated_by_user_id : uuid <<FK>>
  * row_version : integer
}
entity provider_credentials {
  * id : uuid <<PK>>
  --
  * connection_id : uuid <<FK>>
  * secret_type_concept_id : uuid <<FK>>
    secret_ref : varchar
    encrypted : boolean
    rotated_at : timestamptz
    expires_at : timestamptz
  * state_concept_id : uuid <<FK>>
  * created_at : timestamptz
  * updated_at : timestamptz
    created_by_user_id : uuid <<FK>>
    updated_by_user_id : uuid <<FK>>
  * row_version : integer
}
entity integration_endpoints {
  * id : uuid <<PK>>
  --
  * provider_id : uuid <<FK>>
  * code : varchar
  * operation : varchar
    http_method_concept_id : uuid <<FK>>
    path : text
    request_schema_json : jsonb
    response_schema_json : jsonb
  * version : varchar
    timeout_ms : integer
  * state_concept_id : uuid <<FK>>
  * created_at : timestamptz
  * updated_at : timestamptz
    created_by_user_id : uuid <<FK>>
    updated_by_user_id : uuid <<FK>>
  * row_version : integer
}
entity outbound_messages {
  * id : uuid <<PK>>
  --
  * connection_id : uuid <<FK>>
    endpoint_id : uuid <<FK>>
  * correlation_id : varchar
    idempotency_key : varchar <<UK>>
  * request_payload_json : jsonb
    headers_json : jsonb
  * payload_version : integer
  * status_concept_id : uuid <<FK>>
    scheduled_at : timestamptz
    sent_at : timestamptz
    source_resource_type : varchar
    source_resource_id : uuid
  * created_at : timestamptz
  * updated_at : timestamptz
    created_by_user_id : uuid <<FK>>
    updated_by_user_id : uuid <<FK>>
  * row_version : integer
}
entity inbound_messages {
  * id : uuid <<PK>>
  --
  * connection_id : uuid <<FK>>
    endpoint_id : uuid <<FK>>
    correlation_id : varchar
  * payload_json : jsonb
    signature : varchar
  * payload_version : integer
  * status_concept_id : uuid <<FK>>
    received_at : timestamptz
  * created_at : timestamptz
  * updated_at : timestamptz
    created_by_user_id : uuid <<FK>>
    updated_by_user_id : uuid <<FK>>
  * row_version : integer
}
entity message_responses {
  * id : uuid <<PK>>
  --
  * outbound_message_id : uuid <<FK>>
    http_status : integer
  * response_payload_json : jsonb
    latency_ms : integer
    is_success : boolean
    received_at : timestamptz
  * created_at : timestamptz
  * updated_at : timestamptz
    created_by_user_id : uuid <<FK>>
    updated_by_user_id : uuid <<FK>>
  * row_version : integer
}
entity message_retries {
  * id : uuid <<PK>>
  --
  * outbound_message_id : uuid <<FK>>
  * attempt_number : integer
  * status_concept_id : uuid <<FK>>
    error_text : text
    request_snapshot_json : jsonb
  * payload_version : integer
    attempted_at : timestamptz
    next_retry_at : timestamptz
  * created_at : timestamptz
  * updated_at : timestamptz
    created_by_user_id : uuid <<FK>>
    updated_by_user_id : uuid <<FK>>
  * row_version : integer
}
entity webhook_subscriptions {
  * id : uuid <<PK>>
  --
    provider_id : uuid <<FK>>
    tenant_id : uuid <<FK>>
  * event_type : varchar
  * callback_url : text
    secret_ref : varchar
  * state_concept_id : uuid <<FK>>
  * created_at : timestamptz
  * updated_at : timestamptz
    created_by_user_id : uuid <<FK>>
    updated_by_user_id : uuid <<FK>>
  * row_version : integer
}
entity integration_field_mappings {
  * id : uuid <<PK>>
  --
  * endpoint_id : uuid <<FK>>
  * source_path : varchar
  * target_field : varchar
    concept_map_id : uuid <<FK>>
    transform_json : jsonb
    direction_concept_id : uuid <<FK>>
  * created_at : timestamptz
  * updated_at : timestamptz
    created_by_user_id : uuid <<FK>>
    updated_by_user_id : uuid <<FK>>
  * row_version : integer
}

external_providers ||--o{ provider_connections
provider_connections ||--o{ provider_credentials
external_providers ||--o{ integration_endpoints
provider_connections ||--o{ outbound_messages
integration_endpoints |o--o{ outbound_messages
provider_connections ||--o{ inbound_messages
outbound_messages ||--o{ message_responses
outbound_messages ||--o{ message_retries
external_providers ||--o{ webhook_subscriptions
integration_endpoints ||--o{ integration_field_mappings

note as DEP_diagram_12_integrations
  Connects to other modules via:
  inbound_messages_history, integration_endpoints_history,
  message_retries_history, outbound_messages_history,
  provider_connections_history, tenants
end note

note as REC_POLY_INTEG_diagram_12_integrations
  REC 3.1 — POLYMORPHIC SOURCE REFERENCE
outbound_messages.(source_resource_type,source_resource_id) links a message
back to the business record that triggered it. Polymorphic by nature;
constrain source_resource_type to a closed value_set.
end note


