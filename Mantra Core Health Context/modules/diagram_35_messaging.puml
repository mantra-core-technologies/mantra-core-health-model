note as REC_POLY_MSG_diagram_35b_notification_delivery
  notification_requests.(related_resource_type, related_resource_id) is polymorphic;
  validate the type through a closed value set. debounce_key collapses duplicate
  notifications while preserving one auditable request and its delivery attempts.
end note


