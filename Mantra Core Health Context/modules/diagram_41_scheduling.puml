  UX ux_appointment_payment_states_booking : (appointment_booking_id) UNIQUE BTREE
  IX ix_appointment_payment_states_tenant_status : (tenant_id, status_concept_id) BTREE
  IX ix_appointment_payment_states_status_concept_id : (status_concept_id) BTREE
  IX ix_appointment_payment_states_marked_by_user_id : (marked_by_user_id) BTREE
}
