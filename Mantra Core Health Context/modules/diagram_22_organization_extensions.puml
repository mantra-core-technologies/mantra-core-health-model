note as BIZ_diagram_22_organization_extensions
  BUSINESS PURPOSE
  Keeps one generic infrastructure model while giving hospitals, diagnostic
  units and pharmacies explicit domain identities. Specialized records extend
  an existing tenant/practice instead of duplicating organization, location,
  membership, public-profile or authorization data.
end note

entity hospitals {
  * id : uuid <<PK>>
  --
  * tenant_id : uuid <<FK,UK>>
  * practice_id : uuid <<FK,UK>>
    primary_practice_site_id : uuid <<FK>>
    public_profile_id : uuid <<FK>>
  * hospital_type_concept_id : uuid <<FK>>
    care_level_concept_id : uuid <<FK>>
    ownership_type_concept_id : uuid <<FK>>
    teaching_status_concept_id : uuid <<FK>>
    emergency_capability_concept_id : uuid <<FK>>
    licensed_bed_capacity : integer
    operational_bed_capacity : integer
  * status_concept_id : uuid <<FK>>
  * created_at : timestamptz
  * updated_at : timestamptz
    created_by_user_id : uuid <<FK>>
    updated_by_user_id : uuid <<FK>>
  * row_version : integer
}

entity hospital_service_lines {
  * id : uuid <<PK>>
  --
