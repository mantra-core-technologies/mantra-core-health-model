entity "INDEXES · procedure_cases" as idxset_procedure_cases <<INDEX_SET>> {
  PK pk_procedure_cases : (id) UNIQUE BTREE
  IX ix_procedure_cases_custodian_tenant_id : (custodian_tenant_id) BTREE
