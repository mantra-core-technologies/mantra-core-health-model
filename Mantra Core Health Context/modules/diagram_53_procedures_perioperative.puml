  IX ix_procedure_cases_priority_concept_id : (priority_concept_id) BTREE
  IX ix_procedure_cases_status_concept_id : (status_concept_id) BTREE
  IX ix_procedure_cases_surgical_specialty_concept_id : (surgical_specialty_concept_id) BTREE
  IX ix_procedure_cases_requested_by_profile_id : (requested_by_profile_id) BTREE
  IX ix_procedure_cases_primary_surgeon_profile_id : (primary_surgeon_profile_id) BTREE
  IX ix_procedure_cases_anesthesiologist_profile_id : (anesthesiologist_profile_id) BTREE
  IX ix_procedure_cases_practice_site_id : (practice_site_id) BTREE
  IX ix_procedure_cases_operating_room_id : (operating_room_id) BTREE
