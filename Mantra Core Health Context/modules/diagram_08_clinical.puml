entity medication_requests {
  * id : uuid <<PK>>
  --
  * custodian_tenant_id : uuid <<FK>>
  * patient_profile_id : uuid <<FK>>
    encounter_id : uuid <<FK>>
  * medication_concept_id : uuid <<FK>>
    substance_atc_concept_id : uuid <<FK>>
    intent_concept_id : uuid <<FK>>
  * status_concept_id : uuid <<FK>>
    prescriber_profile_id : uuid <<FK>>
    dose_text : varchar
    route_concept_id : uuid <<FK>>
    frequency_text : varchar
    quantity_decimal : numeric
    unit_concept_id : uuid <<FK>>
    valid_from : timestamptz
    valid_to : timestamptz
  ' + v4.1.3: indicaciones al paciente que se imprimen en la receta. Separadas de
  ' dose_text a propósito: la posología la lee farmacia para dispensar y no debe
  ' llevar narrativa ("tomar con las comidas") concatenada.
    patient_instructions_text : text
  ' + v4.1.6: el diagnóstico que motiva la prescripción — «para qué es» esta receta.
  ' Compartir el encuentro con una condición no dice cuál de las condiciones del
  ' paciente se está tratando, y esa respuesta la necesitan tres lectores: el papel
  ' impreso, la validación farmacológica (dosis y contraindicación dependen de la
  ' indicación) y la renovación, que arrastra el motivo del original.
  ' Nullable a propósito: hay prescripciones legítimas sin condición registrada
  ' (sintomática, profilaxis, receta cargada antes de codificar el diagnóstico), y
  ' obligar aquí bloquearía el acto clínico para completar el dato administrativo.
  ' La convención por nombre no resuelve el destino (no existe tabla
  ' `indication_conditions`): se declara en la nota del vault
  ' `SALUD/FK/FK clinical.medication_requests.indication_condition_id.md`.
    indication_condition_id : uuid <<FK>>
  ' + v4.2.38: el motivo de la receta en texto libre, para prescribir sin un diagnóstico
  ' codificado. Excluyente con indication_condition_id (gana el concepto; lo aplica el
  ' servicio). Aditivo y anulable. Estaba en el parche 2026-10-11_v4238 y en la entidad.
    indication_text : varchar(200)
  ' + v4.2.32 (P43): receta emitida desde la respuesta CERRADA del formulario médico.
  ' Nullable y sin backfill. FK → forms.form_instances.
    form_instance_id : uuid <<FK>>
  * created_at : timestamptz
  * updated_at : timestamptz
    created_by_user_id : uuid <<FK>>
    updated_by_user_id : uuid <<FK>>
  * row_version : integer
  ' + v4.0.8 (ALOVIDA D-05 / CAN-RX): firma de la receta y máquina de estados.
  ' Todas NULLABLE: una receta sin firmar tiene signed_at/signed_by en NULL, y la
  ' firma solo se exige cuando una prescription_signature_policies vigente lo pide.
    signed_at : timestamptz
    signed_by_user_id : uuid <<FK>>
    issued_at : timestamptz
    status_reason_text : text
  ' Autorreferencias (invalidar / reemplazar / renovar). La convención por nombre
  ' no resuelve el autoenlace, así que el destino se declara en la nota del vault
  ' `SALUD/FK/FK clinical.medication_requests.<col>.md`.
    replaces_request_id : uuid <<FK>>
    replaced_by_request_id : uuid <<FK>>
    renewed_from_request_id : uuid <<FK>>
  ' + v4.0.9 (ALOVIDA CAN §6, MISSING_IDEMPOTENCY): la emisión de una receta no era
  ' idempotente y un reintento del cliente podía re-ejecutar el sellado. Con la
  ' clave, el reintento devuelve la receta ya emitida en vez de emitir otra.
  ' Nullable: las emisiones históricas no la traen, y por eso su índice único es
  ' PARCIAL — no se les exige retroactivamente.
    issue_idempotency_key : varchar
}

' + v4.0.8 (ALOVIDA D-05) — Política PARAMETRIZABLE de firma de receta.
' Las dimensiones NULLABLE actúan de comodín ("aplica a todas"): gana la política
' vigente más específica, con desempate por effective_from más reciente. Diseño
' fail-safe: sin política aplicable NO se exige firma.
entity prescription_signature_policies {
  * id : uuid <<PK>>
  --
  * tenant_id : uuid <<FK>>
    jurisdiction_code : varchar(16)
    medication_type_concept_id : uuid <<FK>>
    channel_concept_id : uuid <<FK>>
  * signature_required : boolean
  * effective_from : timestamptz
    effective_to : timestamptz
  * created_at : timestamptz
  * updated_at : timestamptz
    created_by_user_id : uuid <<FK>>
    updated_by_user_id : uuid <<FK>>
  * row_version : integer
}

entity "INDEXES · prescription_signature_policies" as idxset_prescription_signature_policies <<INDEX_SET>> {
  PK pk_prescription_signature_policies : (id) UNIQUE BTREE
  IX ix_prescription_signature_policies_tenant_id : (tenant_id) BTREE
}
prescription_signature_policies .. idxset_prescription_signature_policies : indexed by

