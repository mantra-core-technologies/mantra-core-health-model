' ------------------------------------------------------------------------------
' + v4.2.49 (LAB-VIS-001..014 / LAB-RSL-008, issue #56): visitadores del LABORATORIO MEDICO.
' pharma_lab.medical_visitors ancla al visitador en pharma_lab.pharma_labs (farmaceutico,
' fabricante, distribuidor...); una unidad diagnostica no podia tener visitadores que
' presenten sus servicios a los doctores. Se REPLICA el patron en este schema en vez de
' generalizar el ancla de pharma_lab: asi ninguna columna NOT NULL de pharma_lab cambia de
' significado. Mismos campos y misma maquina de estados (conceptos) que sus homologas de
' pharma_lab, sin lo que es propio del farmaceutico (materiales informativos, productos,
' personal del laboratorio). Las politicas y ventanas de visita son del DOCTOR
' (pharma_lab.doctor_visit_policies / doctor_visit_windows) y se reusan tal cual: no hay copia.
'
' LAB-VIS-012 / LAB-RSL-008 — un visitador NO accede a historial, recetas ni resultados.
' Nace con el dominio: ninguna de estas tablas tiene una columna que apunte a un paciente,
' un encuentro, una receta o un resultado, y ninguna debe agregarla.
' ------------------------------------------------------------------------------
entity unit_medical_visitors {
  * id : uuid <<PK>>
  --
  * diagnostic_unit_id : uuid <<FK>>
  * user_id : uuid <<FK>>
  * full_name : varchar
    photo_url : varchar
  * internal_code : varchar
    position : varchar
    supervisor_user_id : uuid <<FK>>
    branch_id : uuid <<FK>>
    region : varchar
    commercial_area : varchar
    assigned_zone : varchar
  * started_on : date
    ended_on : date
  * identity_verification_concept_id : uuid <<FK>>
  * contract_verification_concept_id : uuid <<FK>>
  * credential_verification_concept_id : uuid <<FK>>
  * status_concept_id : uuid <<FK>>
  * publicly_listed : boolean <<DEFAULT_TRUE>>
    unlinked_at : timestamptz
    unlink_reason : text
  * created_at : timestamptz
  * updated_at : timestamptz
    created_by_user_id : uuid <<FK>>
    updated_by_user_id : uuid <<FK>>
  * row_version : integer
}

