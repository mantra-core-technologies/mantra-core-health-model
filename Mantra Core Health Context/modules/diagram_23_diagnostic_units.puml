@startuml SALUD_Module_23_diagnostic_units
title Module 23 — Diagnostic Units, Studies, Specialists and Prices\n(schema: diagnostic_units)
skinparam shadowing false
skinparam linetype ortho
skinparam packageStyle rectangle
hide circle

' ------------------------------------------------------------------------------
' SOURCE CONSOLIDATED: diagram_23_diagnostic_units.puml
' ------------------------------------------------------------------------------
note as BIZ_diagram_23_diagnostic_units
  BUSINESS PURPOSE
  Gives a diagnostic unit a first-class identity, its own governance boundary,
  professionals, specialties, study catalog, public profile and versioned prices.
  Clinical results remain in diagnostics; this module describes the provider
  and the services it offers to patients, doctors and insurers.
end note

entity diagnostic_units {
  * id : uuid <<PK>>
  --
  * tenant_id : uuid <<FK,UK>>
    practice_id : uuid <<FK>>
    primary_practice_site_id : uuid <<FK>>
  * code : varchar <<UK>>
  * name : varchar
  * diagnostic_unit_type_concept_id : uuid <<FK>>
    ownership_type_concept_id : uuid <<FK>>
    public_profile_id : uuid <<FK>>
    accepts_external_orders : boolean
    walk_in_available : boolean
    home_collection_available : boolean
  * verification_status_concept_id : uuid <<FK>>
  * status_concept_id : uuid <<FK>>
  * created_at : timestamptz
  * updated_at : timestamptz
    created_by_user_id : uuid <<FK>>
    updated_by_user_id : uuid <<FK>>
  * row_version : integer
}

