' Plantilla de rol: paquete de acciones por defecto (SECRETARY, MEDICAL_ASSISTANT, NURSING,
' FRONT_DESK, BILLING_CASHIER, CALL_CENTER, ORG_MANAGEMENT). tenant_id NULL = plantilla de
' plataforma; con tenant_id, plantilla propia de la organizacion. default_actions_json es
' un arreglo de codigos de authz.permissions (p. ej. ["schedule.view","schedule.create"]).
entity role_templates {
  * id : uuid <<PK>>
  --
    tenant_id : uuid <<FK>>
  * code : varchar
  * name : varchar
  * default_actions_json : jsonb
  * status_concept_id : uuid <<FK>>
  * version_number : integer
  * created_at : timestamptz
  * updated_at : timestamptz
    created_by_user_id : uuid <<FK>>
    updated_by_user_id : uuid <<FK>>
  * row_version : integer
  ' + v4.2.78: default_conditions_json = mapa atomo -> condicion v1 que recibe una concesion NUEVA; ceiling_actions_json = arreglo de
  ' atomos o `prefijo.*` que la plantilla puede otorgar como maximo (NULL = sin techo propio). Las plantillas de plataforma v2 los traen.
    default_conditions_json : jsonb
    ceiling_actions_json : jsonb
}

' Un permiso concedido a un vinculo de apoyo. target_kind_concept_id dice que columnas
' de objetivo deben venir llenas (ver ck_support_scope_grants_target_coherent en el modulo 33).
' LOCATION usa care_space_id (edificio/piso/sala) O practice_site_id (sede), exactamente uno.
' expansion_mode DYNAMIC: sigue lo que haya en la organizacion al evaluar (doctores/salas nuevos
' entran solos). FIXED: congela la lista en fixed_snapshot_json
' ({"rows":[{"practitionerRoleAssignmentId":..,"healthcareServiceId":..,"careSpaceId":..}]}).
entity support_scope_grants {
  * id : uuid <<PK>>
  --
  ' v4.2.76 (hardening): tenant_id ancla la fila a la organizacion para RLS. Debe ser el tenant del
  ' vinculo (organization_user_assignments -> tenant_memberships) y el de cada objetivo que traiga
  ' (doctor, servicio, espacio, sede): lo exige el trigger integrity.trg_support_tenant_consistency.
  * tenant_id : uuid <<FK>>
  * organization_user_assignment_id : uuid <<FK>>
  * target_kind_concept_id : uuid <<FK>>
    practitioner_role_assignment_id : uuid <<FK>>
    healthcare_service_id : uuid <<FK>>
    care_space_id : uuid <<FK>>
    practice_site_id : uuid <<FK>>
  * expansion_mode_concept_id : uuid <<FK>>
    fixed_snapshot_json : jsonb
    valid_from : timestamptz
    valid_to : timestamptz
  * status_concept_id : uuid <<FK>>
    approved_by_user_id : uuid <<FK>>
  * created_at : timestamptz
  * updated_at : timestamptz
    created_by_user_id : uuid <<FK>>
    updated_by_user_id : uuid <<FK>>
  * row_version : integer
  ' + v4.2.78: efecto ALLOW (por defecto) o DENY. Un DENY NO es un permiso: refresh_effective_support_access y EffectiveSupportAccessService
  ' lo excluyen de la derivada. condition_json = condiciones ABAC v1 de la concesion (su version va en condition_schema_version).
  * effect_concept_id : uuid <<FK, DEFAULT_UUID:6905e0db-1650-5d49-adca-8b2688ac049c>>
    condition_json : jsonb
    condition_schema_version : integer
    reason_text : text
    source_role_template_id : uuid <<FK>>
}

entity support_grant_actions {
  * id : uuid <<PK>>
  --
  ' v4.2.76: tenant_id = tenant del permiso (trigger integrity.trg_support_tenant_consistency).
  * tenant_id : uuid <<FK>>
  * support_scope_grant_id : uuid <<FK>>
  * permission_id : uuid <<FK>>
  * created_at : timestamptz
  ' + v4.2.78: condicion propia del atomo y marca de fila REEMPLAZADA por normalize-legacy (superseded_at: se ignora al evaluar, no se borra).
    condition_json : jsonb
    condition_schema_version : integer
    superseded_at : timestamptz
    updated_at : timestamptz
    updated_by_user_id : uuid <<FK>>
}

' Solicitud (la persona pide a la organizacion) o invitacion (la organizacion invita a la
