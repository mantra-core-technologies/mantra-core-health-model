' identificadores y numeros, NUNCA texto libre ni datos del paciente.
entity access_decision_log <<IMMUTABLE>> {
  * id : uuid <<PK>>
  --
  * tenant_id : uuid <<FK>>
  * user_id : uuid <<FK>>
  * permission_code : varchar
  * effect_concept_id : uuid <<FK>>
  * reason_code : varchar
    grant_id : uuid <<FK>>
    rule_id : uuid
    practitioner_role_assignment_id : uuid
    healthcare_service_id : uuid
    care_space_id : uuid
    patient_profile_id : uuid
    approval_id : uuid <<FK>>
    correlation_id : uuid
    session_id : uuid
    ip : inet
    detail_json : jsonb
  * recorded_at : timestamptz
    recorded_by_user_id : uuid <<FK>>
}

' 11/12 · uso agregado por hora de cada concesion (derivada, no WORM): la escribe un buffer en proceso; perder <= 30 s de estadistica es aceptable.
entity grant_usage_stats {
  * id : uuid <<PK>>
  --
  * tenant_id : uuid <<FK>>
  * user_id : uuid <<FK>>
  * support_scope_grant_id : uuid <<FK>>
  * permission_code : varchar
  * bucket_start : timestamptz
  * permit_count : integer <<DEFAULT_INT:0>>
  * deny_count : integer <<DEFAULT_INT:0>>
  * challenge_count : integer <<DEFAULT_INT:0>>
  * off_hours_count : integer <<DEFAULT_INT:0>>
  * distinct_patients_in_bucket : integer <<DEFAULT_INT:0>>
    last_used_at : timestamptz
  * updated_at : timestamptz
}

' 12/12 · anomalias de actividad detectadas por reglas deterministas (sin aprendizaje automatico).
entity access_anomalies {
  * id : uuid <<PK>>
  --
  * tenant_id : uuid <<FK>>
  * user_id : uuid <<FK>>
    organization_user_assignment_id : uuid <<FK>>
  * kind_concept_id : uuid <<FK>>
  * window_start : timestamptz
  * window_end : timestamptz
  * observed_value : numeric(12,2)
    baseline_value : numeric(12,2)
  * threshold_value : numeric(12,2)
  * evidence_json : jsonb
  * status_concept_id : uuid <<FK>>
    acknowledged_by_user_id : uuid <<FK>>
    acknowledged_at : timestamptz
    resolution_comment_text : text
  * created_at : timestamptz
  * updated_at : timestamptz
    created_by_user_id : uuid <<FK>>
    updated_by_user_id : uuid <<FK>>
  * row_version : integer
}

' --- relaciones de las tablas nuevas
sod_rules }o--o| sod_rules : base_rule_id
sod_exceptions }o--|| sod_rules : sod_rule_id
sod_exceptions }o--|| organization_user_assignments : organization_user_assignment_id
sod_exceptions }o--|| four_eyes_requests : four_eyes_request_id
four_eyes_requests }o--o| organization_user_assignments : organization_user_assignment_id
access_review_items }o--|| access_review_campaigns : access_review_campaign_id
access_review_items }o--|| organization_user_assignments : organization_user_assignment_id
access_review_items }o--o| support_scope_grants : support_scope_grant_id
lifecycle_cases }o--|| organization_user_assignments : organization_user_assignment_id
handover_items }o--|| lifecycle_cases : lifecycle_case_id
patient_restriction_flags }o--|| profiles_patient_profiles : patient_profile_id
access_decision_log }o--o| support_scope_grants : grant_id
access_decision_log }o--o| four_eyes_requests : approval_id
grant_usage_stats }o--|| support_scope_grants : support_scope_grant_id
access_anomalies }o--o| organization_user_assignments : organization_user_assignment_id

