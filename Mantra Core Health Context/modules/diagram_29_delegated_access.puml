entity practitioner_delegate_assignments {
  * id : uuid <<PK>>
  --
  ' + v4.2.79 (revision de seguridad A-M1): tenant_id ancla la delegacion a la organizacion para RLS. Debe ser el tenant de
  ' su set de permisos, de su vinculo y de su doctor (trigger integrity.support_tenant_consistency).
  * tenant_id : uuid <<FK>>
  * practitioner_role_assignment_id : uuid <<FK>>
  * delegate_user_assignment_id : uuid <<FK>>
  * delegated_permission_set_id : uuid <<FK>>
  * delegate_role_concept_id : uuid <<FK>>
    patient_scope_concept_id : uuid <<FK>>
    appointment_scope_concept_id : uuid <<FK>>
    may_view_clinical_content : boolean
    may_edit_drafts : boolean
    may_sign_clinical_content : boolean
    valid_from : timestamptz
    valid_to : timestamptz
  * status_concept_id : uuid <<FK>>
  * created_at : timestamptz
  * updated_at : timestamptz
    created_by_user_id : uuid <<FK>>
    updated_by_user_id : uuid <<FK>>
  * row_version : integer
  ' + v4.2.75 (personal de apoyo): el doctor acepta UNA vez al afiliarse (clausula de personal de apoyo) y,
  ' para que la persona responda mensajes en su nombre, la acepta a ELLA (may_reply_on_behalf).
  ' reply_disclosure_concept_id: SHOW = el paciente ve 'respondido por su equipo' (activo por defecto).
  * may_reply_on_behalf : boolean <<DEFAULT_FALSE>>
    reply_disclosure_concept_id : uuid <<FK>>
    accepted_at : timestamptz
}

' + v4.2.49 (A-12 / PAC-DIAG-012 / DOC-RX-029, issue #59): compartir TEMPORALMENTE un estudio o una
' receta con alguien sin cuenta (un profesional externo, la farmacia receptora). El acceso
' es un secreto opaco: en la base solo vive su hash (token_hash), nunca el secreto, y el id de
' la fila NO es el secreto. Tiene alcance (que recurso y que puede hacer quien lo presenta),
' vence (expires_at) y se revoca (revoked_at) sin tocar el recurso. Cada presentacion del
' token, aceptada o no, deja una fila en shared_access_link_uses.
' resource_type_concept_id + resource_id es polimorfico a proposito (estudio, receta), igual
' que file_links.owner_type_concept_id + owner_id: la API debe resolver resource_id contra la
' tabla que el tipo nombra y comprobar que pertenece a patient_profile_id.
entity shared_access_links {
  * id : uuid <<PK>>
  --
  * tenant_id : uuid <<FK>>
  * patient_profile_id : uuid <<FK>>
  * resource_type_concept_id : uuid <<FK>>
  * resource_id : uuid
  * token_hash : varchar <<UK>>
  * scope_concept_id : uuid <<FK>>
    recipient_kind_concept_id : uuid <<FK>>
    recipient_label : varchar
    purpose_of_use_concept_id : uuid <<FK>>
  * expires_at : timestamptz
    revoked_at : timestamptz
    revoked_by_user_id : uuid <<FK>>
    revoke_reason_text : text
  * status_concept_id : uuid <<FK>>
  * created_at : timestamptz
  * updated_at : timestamptz
    created_by_user_id : uuid <<FK>>
    updated_by_user_id : uuid <<FK>>
  * row_version : integer
}

entity shared_access_link_uses <<LOG>> {
  * id : uuid <<PK>>
  --
  * shared_access_link_id : uuid <<FK>>
  * action_concept_id : uuid <<FK>>
  * outcome_concept_id : uuid <<FK>>
    source_ip : inet
    user_agent : varchar
  * occurred_at : timestamptz
  * created_at : timestamptz
}

