@startuml SALUD_Module_29_delegated_access
title Module 29 — Delegated Access and Scoped Infrastructure Users\n(schema: delegated_access)
skinparam shadowing false
skinparam linetype ortho
skinparam packageStyle rectangle
hide circle

' ------------------------------------------------------------------------------
' SOURCE CONSOLIDATED: diagram_29_delegated_access.puml
' ------------------------------------------------------------------------------
note as BIZ_diagram_29_delegated_access
  BUSINESS PURPOSE
  Lets hospitals, offices, nursing facilities, diagnostic units and pharmacies
  associate additional users and lets doctors delegate limited work to
  secretaries, assistants, nurses or billing staff without sharing credentials.
end note

entity organization_user_assignments {
  * id : uuid <<PK>>
  --
  * tenant_membership_id : uuid <<FK>>
    practice_id : uuid <<FK>>
    practice_site_id : uuid <<FK>>
    clinical_unit_id : uuid <<FK>>
    care_space_id : uuid <<FK>>
    diagnostic_unit_id : uuid <<FK>>
    pharmacy_id : uuid <<FK>>
  * assignment_role_concept_id : uuid <<FK>>
  * access_scope_concept_id : uuid <<FK>>
    supervisor_user_id : uuid <<FK>>
    valid_from : timestamptz
    valid_to : timestamptz
  * status_concept_id : uuid <<FK>>
  * created_at : timestamptz
  * updated_at : timestamptz
    created_by_user_id : uuid <<FK>>
    updated_by_user_id : uuid <<FK>>
  * row_version : integer
}

entity delegated_permission_sets {
  * id : uuid <<PK>>
  --
  * tenant_id : uuid <<FK>>
  * code : varchar
  * name : varchar
  * delegate_type_concept_id : uuid <<FK>>
    description : text
  * status_concept_id : uuid <<FK>>
  * version_number : integer
  * created_at : timestamptz
  * updated_at : timestamptz
    created_by_user_id : uuid <<FK>>
    updated_by_user_id : uuid <<FK>>
  * row_version : integer
}

entity delegated_permission_set_items {
  * id : uuid <<PK>>
  --
  * delegated_permission_set_id : uuid <<FK>>
  * permission_id : uuid <<FK>>
    constraint_json : jsonb
    requires_step_up_authentication : boolean
  * created_at : timestamptz
}

entity practitioner_delegate_assignments {
  * id : uuid <<PK>>
  --
  * practitioner_role_assignment_id : uuid <<FK>>
  * delegate_user_assignment_id : uuid <<FK>>
  * delegated_permission_set_id : uuid <<FK>>
  * delegate_role_concept_id : uuid <<FK>>
    patient_scope_concept_id : uuid <<FK>>
    appointment_scope_concept_id : uuid <<FK>>
    may_view_clinical_content : boolean
    may_edit_drafts : boolean
    may_sign_clinical_content : boolean
    valid_from : timestamptz
    valid_to : timestamptz
  * status_concept_id : uuid <<FK>>
  * created_at : timestamptz
  * updated_at : timestamptz
    created_by_user_id : uuid <<FK>>
    updated_by_user_id : uuid <<FK>>
  * row_version : integer
}

entity delegated_access_grants {
  * id : uuid <<PK>>
  --
  * practitioner_delegate_assignment_id : uuid <<FK>>
  * grant_type_concept_id : uuid <<FK>>
  * purpose_of_use_concept_id : uuid <<FK>>
    patient_profile_id : uuid <<FK>>
    encounter_id : uuid <<FK>>
    resource_type_concept_id : uuid <<FK>>
    valid_from : timestamptz
    valid_to : timestamptz
    approved_by_user_id : uuid <<FK>>
  * status_concept_id : uuid <<FK>>
  * created_at : timestamptz
  * updated_at : timestamptz
    created_by_user_id : uuid <<FK>>
    updated_by_user_id : uuid <<FK>>
  * row_version : integer
}

entity delegated_access_approval_requests {
  * id : uuid <<PK>>
  --
  * practitioner_delegate_assignment_id : uuid <<FK>>
  * requested_permission_id : uuid <<FK>>
    patient_profile_id : uuid <<FK>>
    encounter_id : uuid <<FK>>
    reason_text : text
    requested_at : timestamptz
    decided_at : timestamptz
    decided_by_user_id : uuid <<FK>>
  * decision_concept_id : uuid <<FK>>
  * status_concept_id : uuid <<FK>>
  * created_at : timestamptz
}

entity delegation_events <<IMMUTABLE>> {
  * id : uuid <<PK>>
  --
  * practitioner_delegate_assignment_id : uuid <<FK>>
  * event_type_concept_id : uuid <<FK>>
    actor_user_id : uuid <<FK>>
    target_user_id : uuid <<FK>>
    reason_concept_id : uuid <<FK>>
    previous_state_hash : varchar
    new_state_hash : varchar
  * occurred_at : timestamptz
  * created_at : timestamptz
}

organization_user_assignments ||--o{ practitioner_delegate_assignments
practitioner_delegate_assignments ||--o{ delegated_access_grants
practitioner_delegate_assignments ||--o{ delegated_access_approval_requests
practitioner_delegate_assignments ||--o{ delegation_events
delegated_permission_sets ||--o{ delegated_permission_set_items
delegated_permission_sets ||--o{ practitioner_delegate_assignments

note as CONTROL_diagram_29_delegated_access
  NON-NEGOTIABLE CONTROLS
  - No credential sharing or impersonation.
  - The effective actor and delegating practitioner are both audited.
  - Delegates cannot sign clinical notes or prescriptions unless a separate
    jurisdiction-approved professional role explicitly permits it.
  - Grants expire, can be revoked immediately and are evaluated per purpose.
end note


