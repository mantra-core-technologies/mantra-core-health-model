note as BIZ_diagram_29_delegated_access
  BUSINESS PURPOSE
  Lets hospitals, offices, nursing facilities, diagnostic units and pharmacies
  associate additional users and lets doctors delegate limited work to
  secretaries, assistants, nurses or billing staff without sharing credentials.
end note

' + infraestructura hospitalaria F5g (2026-10-29): acceso delegado por ESPACIO. Sin columnas
' nuevas: `care_space_id` ya existía y ahora la usa el alcance DA_SCOPE_SPACE. Reglas:
' el alcance exige su objetivo (SCOPE_UNIT → clinical_unit_id, SCOPE_SPACE → care_space_id,
' SCOPE_SITE → practice_site_id: ck_org_user_assignments_scope_target) y hay un solo jefe de
' unidad (DA_ASSIGN_UNIT_HEAD) ACTIVO y vigente por unidad (ex_org_user_assignments_unit_head,
' regla B.5-29). Ambas se declaran en diagram_33 (CHECK_SQL / EXCLUDE_SQL). Que sede, unidad y
' espacio sean del MISMO tenant que la membresía lo garantiza el trigger del patch
' 2026-10-29_infraestructura_f5_operaciones.sql.
entity organization_user_assignments {
  * id : uuid <<PK>>
  --
  ' + v4.2.79 (revision de seguridad A-M1): tenant_id ancla el vinculo a la organizacion para RLS. Debe ser el tenant de
  ' su membresia y de cada nodo de alcance que traiga (trigger integrity.support_tenant_consistency).
  * tenant_id : uuid <<FK>>
  * tenant_membership_id : uuid <<FK>>
    practice_id : uuid <<FK>>
    practice_site_id : uuid <<FK>>
    clinical_unit_id : uuid <<FK>>
    care_space_id : uuid <<FK>>
    diagnostic_unit_id : uuid <<FK>>
    pharmacy_id : uuid <<FK>>
  * assignment_role_concept_id : uuid <<FK>>
  * access_scope_concept_id : uuid <<FK>>
    supervisor_user_id : uuid <<FK>>
    valid_from : timestamptz
    valid_to : timestamptz
  * status_concept_id : uuid <<FK>>
  * created_at : timestamptz
  * updated_at : timestamptz
    created_by_user_id : uuid <<FK>>
    updated_by_user_id : uuid <<FK>>
  * row_version : integer
  ' + v4.2.75 (personal de apoyo): el vinculo de apoyo es persona + organizacion + plantilla + vigencia +
  ' recertificacion. Las columnas de alcance sueltas de arriba (practice_site_id, clinical_unit_id,
  ' care_space_id, diagnostic_unit_id, pharmacy_id) quedan DEPRECADAS: el alcance ahora son filas de
  ' support_scope_grants. No se borran todavia. Todas nullable: los vinculos existentes no las declaran.
    origin_concept_id : uuid <<FK>>
    owner_kind_concept_id : uuid <<FK>>
    role_template_id : uuid <<FK>>
    recertify_every_months : integer
    next_recertification_at : timestamptz
    ended_reason_text : text
  ' + v4.2.80 (alta de la secretaria por solicitud y aceptacion): QUIEN inicio el vinculo
  ' (delegated_access:DA_INITIATOR_SUPPORT_STAFF | DA_INITIATOR_ORGANIZATION | DA_INITIATOR_PRACTITIONER;
  ' los siembra la API). Decide la parte que NO inicio. NULL = no decidible (filas previas u otros flujos):
  ' la API falla cerrada. No se deduce de created_by_user_id (una cuenta puede ser secretaria y doctor a la vez).
    initiated_by_party_concept_id : uuid <<FK>>
  ' + v4.2.78 (gobierno de accesos): verificacion de identidad, suspension, incorporacion y certificacion del vinculo.
  ' supervisor_user_id pasa a significar DUENO DE LA CUENTA (sin renombrar la columna).
    identity_verified_at : timestamptz
    identity_verified_by_user_id : uuid <<FK>>
    identity_method_concept_id : uuid <<FK>>
    suspended_at : timestamptz
    suspension_reason_concept_id : uuid <<FK>>
    suspension_note_text : text
    onboarding_completed_at : timestamptz
    last_certified_at : timestamptz
    last_active_at : timestamptz
}

