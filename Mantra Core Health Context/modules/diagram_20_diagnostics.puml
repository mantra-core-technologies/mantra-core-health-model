  PK pk_specimens : (id) UNIQUE BTREE
  IX ix_specimens_patient_profile_id : (patient_profile_id) BTREE
  IX ix_specimens_service_request_id : (service_request_id) BTREE
  IX ix_specimens_encounter_id : (encounter_id) BTREE
