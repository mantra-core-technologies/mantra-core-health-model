note as BIZ_diagram_27_identity_assurance
  BUSINESS PURPOSE
  Verifies patients, practitioners, representatives and organization operators
  against authoritative ministries, civil registries, professional boards and
  government data platforms. Generic integration retries remain in integrations;
  these tables preserve identity-specific evidence, checks and decisions.
end note

entity identity_authorities {
  * id : uuid <<PK>>
  --
  * tenant_id : uuid <<FK>>
  * authority_code : varchar <<UK>>
  * name : varchar
  * authority_type_concept_id : uuid <<FK>>
    jurisdiction_concept_id : uuid <<FK>>
    assurance_framework_concept_id : uuid <<FK>>
  * verification_status_concept_id : uuid <<FK>>
  * status_concept_id : uuid <<FK>>
  * created_at : timestamptz
  * updated_at : timestamptz
    created_by_user_id : uuid <<FK>>
    updated_by_user_id : uuid <<FK>>
  * row_version : integer
}

entity identity_authority_endpoints {
  * id : uuid <<PK>>
  --
  * identity_authority_id : uuid <<FK>>
  * integration_endpoint_id : uuid <<FK>>
  * capability_concept_id : uuid <<FK>>
