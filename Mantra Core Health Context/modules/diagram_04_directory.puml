entity tenant_memberships {
  * id : uuid <<PK>>
  --
  * user_id : uuid <<FK>>
  * tenant_id : uuid <<FK>>
    primary_branch_id : uuid <<FK>>
  * tenant_role_concept_id : uuid <<FK>>
  * status_concept_id : uuid <<FK>>
  * access_scope_concept_id : uuid <<FK>>
  * start_date : timestamptz
    end_date : timestamptz
    invited_by_user_id : uuid <<FK>>
  * created_at : timestamptz
  * updated_at : timestamptz
    created_by_user_id : uuid <<FK>>
    updated_by_user_id : uuid <<FK>>
  * row_version : integer
  ' + v4.2.49 (ORG-PER-003 / INS-PER-003 / PHAR-PER-004, issue #58): jornada del integrante y
  ' quien responde por el. Nullable: los vinculos existentes no los declaran.
    workday_concept_id : uuid <<FK>>
    responsible_user_id : uuid <<FK>>
  ' + v4.2.77 (revision de seguridad N10): origen de la membresia (directory:MEMBERSHIP_ORIGIN_*:
  ' creada por el dueno, anadida por un administrador, canje de invitacion, SOLO por un vinculo de
  ' apoyo, o desconocido). Nullable: las filas existentes quedan en NULL (= desconocido); NUNCA se
