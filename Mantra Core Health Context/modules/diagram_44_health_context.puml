@startuml SALUD_Module_44_health_context
title Module 44 — Country Health Environment Context\n(schema: health_context)
skinparam shadowing false
skinparam linetype ortho
skinparam packageStyle rectangle
hide circle

' ------------------------------------------------------------------------------
' SOURCE CONSOLIDATED: diagram_44_health_environment_context.puml
' ------------------------------------------------------------------------------
note as BIZ_diagram_44_health_environment_context
  BUSINESS PURPOSE
  Stores country-level health-environment context collected periodically by
  governed agents. Raw observations, evidence, structured facts and approved
  versioned summaries remain traceable to source and collection run.
end note

entity context_agents {
  * id : uuid <<PK>>
  --
  * code : varchar <<UK>>
  * name : varchar
  * agent_type_concept_id : uuid <<FK>>
    provider_id : uuid <<FK>>
    implementation_ref : varchar
    owner_tenant_id : uuid <<FK>>
    last_heartbeat_at : timestamptz
  * status_concept_id : uuid <<FK>>
  * created_at : timestamptz
  * updated_at : timestamptz
    created_by_user_id : uuid <<FK>>
    updated_by_user_id : uuid <<FK>>
  * row_version : integer
}

entity country_context_schedules {
  * id : uuid <<PK>>
  --
  * country_concept_id : uuid <<FK>>
  * agent_id : uuid <<FK>>
  * schedule_expression : varchar
    timezone_concept_id : uuid <<FK>>
    lookback_days : integer
    freshness_ttl_seconds : integer
    next_run_at : timestamptz
    last_success_at : timestamptz
  * status_concept_id : uuid <<FK>>
  * created_at : timestamptz
  * updated_at : timestamptz
    created_by_user_id : uuid <<FK>>
    updated_by_user_id : uuid <<FK>>
  * row_version : integer
}

entity health_context_sources {
  * id : uuid <<PK>>
  --
  * code : varchar <<UK>>
  * name : varchar
  * source_type_concept_id : uuid <<FK>>
    owner_name : varchar
    canonical_url : text
    country_concept_id : uuid <<FK>>
    license_text : text
    trust_tier_concept_id : uuid <<FK>>
  * status_concept_id : uuid <<FK>>
  * created_at : timestamptz
  * updated_at : timestamptz
    created_by_user_id : uuid <<FK>>
    updated_by_user_id : uuid <<FK>>
  * row_version : integer
}

entity context_collection_runs <<LOG>> {
  * id : uuid <<PK>>
  --
    schedule_id : uuid <<FK>>
  * agent_id : uuid <<FK>>
  * country_concept_id : uuid <<FK>>
  * idempotency_key : varchar <<UK>>
  * trigger_concept_id : uuid <<FK>>
  * status_concept_id : uuid <<FK>>
  * started_at : timestamptz
    finished_at : timestamptz
    source_count : integer
    observations_read : bigint
    observations_accepted : bigint
    observations_rejected : bigint
    continuation_cursor_json : jsonb
    error_summary : text
  * recorded_at : timestamptz
    recorded_by_user_id : uuid <<FK>>
}

entity context_source_observations <<IMMUTABLE>> {
  * id : uuid <<PK>>
  --
  * collection_run_id : uuid <<FK>>
  * source_id : uuid <<FK>>
  * country_concept_id : uuid <<FK>>
  * source_locator : text
    published_at : timestamptz
  * retrieved_at : timestamptz
    media_type : varchar
    raw_payload_file_id : uuid <<FK>>
    extracted_payload_json : jsonb
  * content_hash : varchar
  * status_concept_id : uuid <<FK>>
  * recorded_at : timestamptz
    recorded_by_user_id : uuid <<FK>>
}

entity country_health_contexts {
  * id : uuid <<PK>>
  --
  * country_concept_id : uuid <<FK>>
  * context_domain_concept_id : uuid <<FK>>
  * context_key : varchar
  * title : varchar
    description : text
    current_version_id : uuid <<FK>>
  * status_concept_id : uuid <<FK>>
  * created_at : timestamptz
  * updated_at : timestamptz
    created_by_user_id : uuid <<FK>>
    updated_by_user_id : uuid <<FK>>
  * row_version : integer
}

entity country_health_context_versions <<VERSIONED>> {
  * id : uuid <<PK>>
  --
  * country_health_context_id : uuid <<FK>>
  * version_number : integer
  * collection_run_id : uuid <<FK>>
  * schema_version : varchar
    summary : text
  * context_payload_json : jsonb
  * observed_at : timestamptz
  * effective_from : timestamptz
    effective_to : timestamptz
    expires_at : timestamptz
    confidence_score : numeric
  * content_hash : varchar
  * status_concept_id : uuid <<FK>>
  * recorded_at : timestamptz
    recorded_by_user_id : uuid <<FK>>
}

entity health_context_facts <<IMMUTABLE>> {
  * id : uuid <<PK>>
  --
  * context_version_id : uuid <<FK>>
  * fact_key : varchar
  * metric_concept_id : uuid <<FK>>
  * value_type : technical_data_type
  * value_json : jsonb
    unit_concept_id : uuid <<FK>>
    period_start : date
    period_end : date
    confidence_score : numeric
  * status_concept_id : uuid <<FK>>
  * recorded_at : timestamptz
    recorded_by_user_id : uuid <<FK>>
}

entity context_fact_evidence <<IMMUTABLE>> {
  * id : uuid <<PK>>
  --
  * health_context_fact_id : uuid <<FK>>
  * source_observation_id : uuid <<FK>>
    evidence_locator_json : jsonb
    relevance_score : numeric
    evidence_hash : varchar
  * recorded_at : timestamptz
    recorded_by_user_id : uuid <<FK>>
}

entity context_quality_reviews <<LOG>> {
  * id : uuid <<PK>>
  --
  * context_version_id : uuid <<FK>>
    reviewer_agent_id : uuid <<FK>>
    reviewed_by_user_id : uuid <<FK>>
  * review_type_concept_id : uuid <<FK>>
  * outcome_concept_id : uuid <<FK>>
    issues_json : jsonb
    notes : text
  * recorded_at : timestamptz
}

context_agents ||--o{ country_context_schedules
context_agents ||--o{ context_collection_runs
country_context_schedules |o--o{ context_collection_runs
health_context_sources ||--o{ context_source_observations
context_collection_runs ||--o{ context_source_observations
country_health_contexts ||--o{ country_health_context_versions
context_collection_runs ||--o{ country_health_context_versions
country_health_context_versions ||--o{ health_context_facts
health_context_facts ||--o{ context_fact_evidence
context_source_observations ||--o{ context_fact_evidence
country_health_context_versions ||--o{ context_quality_reviews

note as CONTRACT_diagram_44_health_environment_context
  COUNTRY CONTEXT CONTRACT
  - UK: country_health_contexts(country, domain, context_key).
  - UK: country_health_context_versions(context, version_number).
  - A successful scheduled run is idempotent by idempotency_key.
  - current_version_id must point to a version owned by the same context.
  - Published context is time-bounded, freshness-aware and evidence-backed.
end note

note as SAFETY_diagram_44_health_environment_context
  DATA SAFETY
  This schema is for country-level public, licensed or authorized aggregate
  context. Patient-level PHI is prohibited. Agent output is not accepted as
  fact without retained source observations, hashes and quality status.
end note

note as DEP_diagram_44_health_environment_context
  Connects to other modules via:
  terminology.catalog_concepts, integrations.external_providers,
  common.files, directory.tenants and iam.users.
end note


