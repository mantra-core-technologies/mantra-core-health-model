@startuml SALUD_Module_15_chart
title Module 15 — Versioned Patient Chart, Notes and Documents\n(schema: chart)
skinparam shadowing false
skinparam linetype ortho
skinparam packageStyle rectangle
hide circle

' ------------------------------------------------------------------------------
' SOURCE CONSOLIDATED: diagram_15_chart.puml
' ------------------------------------------------------------------------------
note as BIZ_diagram_15_chart
  BUSINESS PURPOSE
  A patient chart with immutable, signed clinical-note versions; explicit
  release to the patient; addenda instead of destructive edits; and a
  document cabinet that supports multiple governed file versions.
end note

entity patient_timeline_view <<VIEW>> {
  --
    patient_profile_id : uuid
    event_type : varchar
    resource_type : varchar
    resource_id : uuid
    resource_version_id : uuid
    event_at : timestamptz
    summary : text
    author_profile_id : uuid
    encounter_id : uuid
    patient_visibility_concept_id : uuid
}
entity clinical_note_headers {
  * id : uuid <<PK>>
  --
  * patient_profile_id : uuid <<FK>>
    encounter_id : uuid <<FK>>
  * note_type_concept_id : uuid <<FK>>
  * lifecycle_status_concept_id : uuid <<FK>>
    current_version_id : uuid <<FK>>
    current_released_version_id : uuid <<FK>>
    patient_release_status_concept_id : uuid <<FK>>
    confidentiality_concept_id : uuid <<FK>>
  * created_at : timestamptz
  * updated_at : timestamptz
    created_by_user_id : uuid <<FK>>
    updated_by_user_id : uuid <<FK>>
  * row_version : integer
}
entity clinical_note_versions <<IMMUTABLE>> {
  * id : uuid <<PK>>
  --
  * clinical_note_id : uuid <<FK>>
  * version_number : integer
  * author_profile_id : uuid <<FK>>
  * status_concept_id : uuid <<FK>>
    chief_complaint_text : text
    subjective_text : text
    objective_text : text
    assessment_text : text
    plan_text : text
    supersedes_version_id : uuid <<FK>>
    amendment_reason_concept_id : uuid <<FK>>
    amendment_reason_text : text
    signed_by_profile_id : uuid <<FK>>
    signed_at : timestamptz
    content_hash : varchar
    release_eligibility_concept_id : uuid <<FK>>
  * recorded_at : timestamptz
    recorded_by_user_id : uuid <<FK>>
}
entity clinical_note_signatures <<IMMUTABLE>> {
  * id : uuid <<PK>>
  --
  * clinical_note_version_id : uuid <<FK>>
  * signer_profile_id : uuid <<FK>>
  * signature_type_concept_id : uuid <<FK>>
