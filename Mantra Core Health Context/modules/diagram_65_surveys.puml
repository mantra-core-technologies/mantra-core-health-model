  * updated_at : timestamptz
    created_by_user_id : uuid <<FK>>
    updated_by_user_id : uuid <<FK>>
  * row_version : integer
}

survey_templates ||--o{ survey_versions
survey_versions ||--o{ survey_questions
survey_versions ||--o{ survey_assignments
survey_versions ||--o{ survey_invitations
survey_assignments ||--o{ survey_invitations
survey_invitations ||--o{ survey_responses
survey_versions ||--o{ survey_responses
survey_responses ||--o{ survey_answers
