@startuml SALUD_Module_65_surveys
title Module 65 — Surveys (post-visit questionnaires)\n(schema: surveys)
skinparam shadowing false
skinparam linetype ortho
skinparam packageStyle rectangle
hide circle

' ------------------------------------------------------------------------------
' SOURCE CONSOLIDATED: promoted from mantra-core-health-api/src/modules/surveys
' The seven entities landed in code on 2026-08-15 (carril 10) with no .puml and
' no line in SQL/, so the schema never existed in any database the pipeline
' builds and every endpoint of the module failed with
' relation "surveys.*" does not exist. This diagram TRANSCRIBES what those
' entities already declare — column, type and nullability — and adds nothing.
' Same case as module 64 (audio_assets).
' ------------------------------------------------------------------------------
note as BIZ_diagram_65_surveys
  BUSINESS PURPOSE
  The practitioner asks the patient how the visit went. A template is owned by
  one professional and published as immutable versions; an assignment says which
  attentions a version applies to; a completed booking issues one invitation to
  one patient, with an expiry derived at issue time; the patient answers once.
  Answers are private by construction: this module has no visibility column and
  never feeds the public rating, which lives in community.service_reviews.
end note

entity survey_templates {
  * id : uuid <<PK>>
  --
  * tenant_id : uuid <<FK>>
  * owner_practitioner_id : uuid <<FK>>
  * title : text
    description : text
  * status_concept_id : uuid <<FK>>
  * created_at : timestamptz
  * updated_at : timestamptz
    created_by_user_id : uuid <<FK>>
    updated_by_user_id : uuid <<FK>>
  * row_version : integer
}

entity survey_versions {
  * id : uuid <<PK>>
  --
  * survey_template_id : uuid <<FK>>
  * version_number : integer
  * publication_status_concept_id : uuid <<FK>>
    effective_from : timestamptz
    effective_to : timestamptz
  * response_window_days : integer
    published_at : timestamptz
  * created_at : timestamptz
  * updated_at : timestamptz
    created_by_user_id : uuid <<FK>>
    updated_by_user_id : uuid <<FK>>
  * row_version : integer
}

entity survey_questions {
  * id : uuid <<PK>>
  --
  * survey_version_id : uuid <<FK>>
  * position : integer
  * question_text : text
  * answer_type_concept_id : uuid <<FK>>
  * required : boolean
    options : jsonb
    scale_min : integer
    scale_max : integer
  * created_at : timestamptz
  * updated_at : timestamptz
    created_by_user_id : uuid <<FK>>
    updated_by_user_id : uuid <<FK>>
  * row_version : integer
}

entity survey_assignments {
  * id : uuid <<PK>>
  --
  * survey_version_id : uuid <<FK>>
  * tenant_id : uuid <<FK>>
  * target_type_concept_id : uuid <<FK>>
  * target_id : uuid
  * active : boolean
  * created_at : timestamptz
  * updated_at : timestamptz
    created_by_user_id : uuid <<FK>>
    updated_by_user_id : uuid <<FK>>
  * row_version : integer
}

entity survey_invitations {
  * id : uuid <<PK>>
  --
  * survey_version_id : uuid <<FK>>
  * survey_assignment_id : uuid <<FK>>
  * tenant_id : uuid <<FK>>
  * patient_profile_id : uuid <<FK>>
  * appointment_booking_id : uuid <<FK>>
  * status_concept_id : uuid <<FK>>
  * issued_at : timestamptz
  * expires_at : timestamptz
    answered_at : timestamptz
  * created_at : timestamptz
  * updated_at : timestamptz
    created_by_user_id : uuid <<FK>>
    updated_by_user_id : uuid <<FK>>
  * row_version : integer
}

entity survey_responses {
  * id : uuid <<PK>>
  --
  * survey_invitation_id : uuid <<FK>>
  * survey_version_id : uuid <<FK>>
  * tenant_id : uuid <<FK>>
  * patient_profile_id : uuid <<FK>>
  * submitted_at : timestamptz
  * created_at : timestamptz
  * updated_at : timestamptz
    created_by_user_id : uuid <<FK>>
    updated_by_user_id : uuid <<FK>>
  * row_version : integer
}

entity survey_answers {
  * id : uuid <<PK>>
  --
  * survey_response_id : uuid <<FK>>
  * survey_question_id : uuid <<FK>>
