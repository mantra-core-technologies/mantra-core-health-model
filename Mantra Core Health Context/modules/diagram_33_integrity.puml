@startuml SALUD_Module_33_integrity
title Module 33 — Concurrency, Constraints and Integrity Matrix\n(schema: integrity)
skinparam shadowing false
skinparam linetype ortho
skinparam packageStyle rectangle
hide circle

' ------------------------------------------------------------------------------
' SOURCE CONSOLIDATED: diagram_33_concurrency_and_integrity.puml
' ------------------------------------------------------------------------------
entity inventory_stock_positions <<REFERENCE_ONLY>> {
  PK : id
  UK : location + product + lot
  CHECK : quantities >= 0
  LOCK : SELECT FOR UPDATE
  VERSION : row_version
}
entity inventory_ledger_entries <<IMMUTABLE, REFERENCE_ONLY>> {
  UK : pharmacy + idempotency_key
  UK : pharmacy + ledger_sequence
  CHECK : non-zero delta
  UPDATE_DELETE : forbidden
}
entity inventory_reservations <<REFERENCE_ONLY>> {
  UK : pharmacy + idempotency_key
  EXCLUDE : active allocation overlap when required
  WORKER : expiration release
}
entity diagnostic_study_prices <<VERSIONED, REFERENCE_ONLY>> {
  UK : schedule + offering + version
  EXCLUDE : no overlapping active effective periods
  CHECK : amounts >= 0
}
entity patient_coverages <<REFERENCE_ONLY>> {
  UK : insurer + member identifier + effective period
  EXCLUDE : conflicting primary coverage periods
}
entity claim_adjudication_versions <<IMMUTABLE, REFERENCE_ONLY>> {
  UK : claim + adjudication version
  UPDATE_DELETE : forbidden
}
entity insurance_claims <<REFERENCE_ONLY>> {
  CHECK_SQL : ck_insurance_claims_single_order_origin | ("inventory_reservation_id" IS NULL OR "service_request_id" IS NULL)
}
entity prior_authorization_requests <<REFERENCE_ONLY>> {
  CHECK_SQL : ck_prior_authorizations_single_order_origin | ("inventory_reservation_id" IS NULL OR "service_request_id" IS NULL)
}
entity service_requests <<REFERENCE_ONLY>> {
  CHECK_SQL : ck_service_requests_override_reason_requires_previous_report | ("duplicate_override_reason" IS NULL OR "previous_diagnostic_report_id" IS NOT NULL)
}
entity insurance_campaigns <<REFERENCE_ONLY>> {
  CHECK_SQL : ck_insurance_campaigns_valid_period | ("valid_from" <= "valid_to")
  CHECK_SQL : ck_insurance_campaigns_copay_bonus_range | ("copay_bonus_percentage" >= 0 AND "copay_bonus_percentage" <= 100)
}
' + v4.2.40 — la oferta de un servicio: duración mínima y máxima coherentes. `NOT NULL` ya
' garantiza que existan; esto garantiza que tengan sentido (positivas, mín ≤ máx, y un
' techo de 12 h que es el mismo del contrato de la API) y que los colchones no sean negativos.
entity practitioner_service_offerings <<REFERENCE_ONLY>> {
  CHECK_SQL : ck_practitioner_service_offerings_duration_range | ("min_duration_minutes" > 0 AND "min_duration_minutes" <= "max_duration_minutes" AND "max_duration_minutes" <= 720)
  CHECK_SQL : ck_practitioner_service_offerings_buffers | (COALESCE("prep_minutes", 0) >= 0 AND COALESCE("cleanup_minutes", 0) >= 0)
}
entity identity_verification_attempts <<REFERENCE_ONLY>> {
  UK : case + endpoint + attempt number
  UK : endpoint + idempotency key
  RETRY : bounded policy only
}
entity user_activity_events <<APPEND_ONLY, REFERENCE_ONLY>> {
  UK : event schema + event idempotency key
  PARTITION : received_at
  RETENTION : purpose-specific
}
entity practitioner_delegate_assignments <<REFERENCE_ONLY>> {
  EXCLUDE : incompatible overlapping assignments
  CHECK : signature permission requires authorized role
}
' + v4.2.3 (H-1) — la regla madre, ahora fisica.
' "El profesional no puede estar en dos lugares a la vez" se cumplia SOLO en el
' servicio (assertRangoLibre + SELECT FOR UPDATE sobre el cupo). Eso dejaba dos
' huecos: el camino que crea el cupo en la misma transaccion no tiene fila previa
' que trabar, y cualquier escritura futura que no pase por ese servicio no ve la
' regla. El defecto se observo: dos pacientes reservaron 14:00-14:30 y 14:15-14:45
' con el MISMO medico en dos agendas distintas y las dos quedaron confirmadas.
'
' EXCLUDE_SQL declara la expresion CONCRETA para que gen_integrity no tenga que
' inventarla (temperatura-0). Formato: nombre | elementos gist | predicado.
' Los estados van como UUID literales y no como funcion: el predicado de un
' EXCLUDE tiene que ser inmutable — es la misma razon por la que
' ux_authentication_credentials_live_password_subject (v4.0.9) los lleva literales,
' y es exactamente por lo que gist_appointments_practitioner_time quedo comentado:
' su predicado llamaba a held_status()/confirmed_status(), que nunca se definieron.
'
' Los dos estados elegidos son los MISMOS que ya comprueba assertRangoLibre:
' APPOINTMENT_BOOKED y APPOINTMENT_CHECKED_IN. No entra PENDING —dos pacientes
' pueden pedir el mismo horario y el medico elige— ni FULFILLED ni CANCELLED. La
' base pasa a rechazar exactamente lo que el servicio ya rechazaba, ni mas ni
' menos: es una red, no una regla nueva.
entity appointments <<REFERENCE_ONLY>> {
  EXCLUDE : practitioner/location time overlap
  EXCLUDE_SQL : ex_appointments_practitioner_time | "practitioner_profile_id" WITH =, tstzrange("start_at", "end_at", '[)') WITH && | "practitioner_profile_id" IS NOT NULL AND "end_at" IS NOT NULL AND "status_concept_id" IN ('51530fd7-05b1-5c29-80c4-da740ede4d27', '37dded87-7a7a-5a24-86f6-0ef48cccb482')
  LOCK : reservation confirmation transaction
}

entity claim_appeal_decisions <<IMMUTABLE, REFERENCE_ONLY>> {
  UK : dispute + decision version
  UPDATE_DELETE : forbidden
}
entity claim_reversals <<IMMUTABLE, REFERENCE_ONLY>> {
  UK : claim + idempotency_key
  UPDATE_DELETE : forbidden
}
entity coordination_of_benefits <<VERSIONED, REFERENCE_ONLY>> {
  UK : patient + determination version
  EXCLUDE : overlapping active COB periods
}

' + v4.0.10 (ALOVIDA CAN-AUDIT-001 / C-19) — WORM real sobre la auditoria.
' "Los registros de auditoria no podran modificarse ni eliminarse". La cadena hash
' de audit_log da tamper-EVIDENCE (se detecta al verificar); estos guards dan
' tamper-RESISTANCE: la base rechaza la mutacion sea cual sea el rol, incluido el
' propietario. Antes vivian como DDL suelto (database/ del repo API, luego
' SQL/patches/) que ningun rebuild aplicaba: la promesa WORM era solo convencion.
entity audit_log <<IMMUTABLE, REFERENCE_ONLY>> {
  UPDATE_DELETE : forbidden
}
' data_access_log es ASIMETRICA a proposito: prohibe UPDATE pero permite DELETE,
' porque la purga de retencion controlada (UC-10-09) borra por ventana explicita.
' Prohibirle el DELETE romperia la retencion; no prohibirle el UPDATE dejaria
' reescribir que dato se divulgo.
entity data_access_log <<APPEND_ONLY, REFERENCE_ONLY>> {
  UPDATE : forbidden
  DELETE : retention purge only (UC-10-09)
}

inventory_stock_positions --> inventory_ledger_entries : atomic projection
inventory_reservations --> inventory_ledger_entries : reserve/release
patient_coverages --> claim_adjudication_versions : adjudication basis
identity_verification_attempts --> practitioner_delegate_assignments : verified actor

note as TX_diagram_33_concurrency_and_integrity
  TRANSACTION POLICY
  - Use READ COMMITTED plus explicit row locks for narrow stock mutations.
  - Use SERIALIZABLE for cross-row invariants that cannot be safely locked by a
    deterministic key; retry the full transaction on SQLSTATE 40001.
  - Keep external API calls outside database lock windows. Persist intent/outbox,
    then reconcile asynchronous results with idempotency.
  - SKIP LOCKED is valid for workers and queues, not for business availability.
end note

note as DB_diagram_33_concurrency_and_integrity
  PHYSICAL DATABASE GATES
  Named CHECK/UNIQUE/EXCLUDE/FK constraints, partial unique indexes, immutable
  triggers, partitioning plans, index evidence and concurrency tests are required
  before migrations are approved. Application validation is never the only guard.
end note

note as NON_OWNING_INTEGRITY_MATRIX
  NON-OWNING INTEGRITY MATRIX
  This module does not create duplicate tables. Every entity shown is a reference
  to the canonical owner module. Named unique, exclusion, check, partition and
  transaction rules must be implemented in the owning table migration and repeated
  here only as a cross-domain verification matrix.
end note

note as INDEX_SCOPE
  INDEX SCOPE
  This module is architectural/use-case/deployment documentation and has no
  owned relational tables. Physical indexes are declared in the owning data modules.
end note

entity "billing.quotations" as billing_quotations <<REFERENCE_ONLY>> {
  CHECK_SQL : chk_quotations_payment_frequency | "payment_frequency" IN ('WEEKLY', 'BIWEEKLY', 'MONTHLY')
  CHECK_SQL : chk_quotations_down_payment_range | ("down_payment_amount" >= 0 AND "down_payment_amount" <= "offered_price")
}
entity "billing.quotation_installments" as billing_quotation_installments <<REFERENCE_ONLY>> {
  CHECK_SQL : chk_quotation_installments_amount_positive | "amount" > 0
}
entity "medical_groups.groups" as medical_groups_groups <<REFERENCE_ONLY>> {
  CHECK_SQL : ck_medical_groups_groups_status | "status" IN ('PENDING_TEAM', 'SCHEDULED', 'RESCHEDULE_PENDING', 'CLOSED')
}
entity "medical_groups.group_members" as medical_groups_group_members <<REFERENCE_ONLY>> {
  CHECK_SQL : ck_medical_groups_group_members_invitation_status | "invitation_status" IN ('PENDING', 'ACCEPTED', 'REJECTED')
}
entity "system_ops.restore_test_runs" as system_ops_restore_test_runs <<REFERENCE_ONLY>> {
  ' MCH-023 (promovido en v4.2.20): NOT_MEASURED nunca puede leerse como "cumple".
  CHECK_SQL : ck_system_ops_restore_test_runs_objective_status | "objective_status" IN ('PASSED', 'FAILED', 'NOT_MEASURED')
}
@enduml
