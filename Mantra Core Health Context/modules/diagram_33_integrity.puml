entity "procedures_perioperative.procedure_cases" as procedures_perioperative_procedure_cases <<REFERENCE_ONLY>> {
  ' ORG-QUI-005: la regla que periop-cases.service ya aplica (findOverlappingCases), ahora en la base.
  ' Estados que ocupan el quirofano (CASE_SCHEDULED, CASE_READY, SURG_CASE_IN_PROGRESS) como UUID
  ' literales: el predicado de un EXCLUDE tiene que ser inmutable. Rango semiabierto [), igual que
  ' la comparacion `<`/`>` del servicio. La preparacion y la limpieza NO entran en el rango: sumar un
  ' intervalo a un timestamptz es STABLE y un indice no lo admite; las aplica el servicio.
  EXCLUDE : operating room time overlap
  EXCLUDE_SQL : ex_procedure_cases_operating_room_time | "operating_room_id" WITH =, tstzrange("scheduled_start_at", "scheduled_end_at", '[)') WITH && | "operating_room_id" IS NOT NULL AND "scheduled_start_at" IS NOT NULL AND "scheduled_end_at" IS NOT NULL AND "status_concept_id" IN ('6fe38139-ad1d-5214-84c1-8c184e4e58fb', 'f6985cd5-f867-5d76-b70c-1138667fd2ab', 'fdc78cc9-eda6-5625-9a26-1bdcec4dc203')
  CHECK_SQL : ck_procedure_cases_buffers | (COALESCE("prep_minutes", 0) >= 0 AND COALESCE("cleanup_minutes", 0) >= 0)
}
