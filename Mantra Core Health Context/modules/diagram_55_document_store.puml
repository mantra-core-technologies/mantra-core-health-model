@startuml SALUD_Module_55_document_store
title Module 55 — Document Store for FHIR, Variable Payloads and Versioned Snapshots\n(MongoDB-compatible document collections)
skinparam shadowing false
skinparam linetype ortho
skinparam packageStyle rectangle
hide circle

note as BIZ_document_store
  BUSINESS PURPOSE
  Stores variable, versioned and externally shaped documents without replacing relational clinical, financial or authorization sources of truth.
  Every PHI-bearing document carries tenant, patient, classification, encryption, retention and lineage metadata.
end note

entity "directory.tenants" as directory_tenants <<REFERENCE_ONLY>> {
  * id : uuid <<PK>>
}

entity "profiles.patient_profiles" as profiles_patient_profiles <<REFERENCE_ONLY>> {
  * id : uuid <<PK>>
}

entity "health_data.canonical_health_resources" as health_data_canonical_resources <<REFERENCE_ONLY>> {
  * id : uuid <<PK>>
}

entity "common.files" as common_files <<REFERENCE_ONLY>> {
  * id : uuid <<PK>>
}

entity "polyglot_storage.collection_definitions" as polyglot_collection_definitions <<REFERENCE_ONLY>> {
  * id : uuid <<PK>>
}

entity document_envelopes <<MONGODB_COLLECTION>> {
  * _id : objectId <<PK>>
  * document_id : uuid
  * tenant_id : uuid
    patient_profile_id : uuid
  * schema_version : varchar
  * source_system : varchar
    external_id : varchar
  * content_hash : varchar
  * contains_phi : boolean
  * encryption_profile_code : varchar
  * created_at : datetime
    updated_at : datetime
    expires_at : datetime
  * retention_class : varchar
  * document_type : varchar
  * lifecycle_state : varchar
  * payload_ref : object
    security_labels : array<object>
    purpose_restrictions : array<object>
    lineage : object
}

entity document_version_documents <<MONGODB_COLLECTION>> {
  * _id : objectId <<PK>>
  * document_id : uuid
  * tenant_id : uuid
