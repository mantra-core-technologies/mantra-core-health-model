storage_backends -- storage_backend_regions : has
storage_backends -- storage_capabilities : declares
dataset_definitions -- dataset_versions : versions
dataset_definitions -- collection_definitions : materializes
collection_definitions -- collection_schema_versions : validates with
dataset_versions -- dataset_placements : placed as
storage_backend_regions -- dataset_placements : hosts
directory_tenants -- tenant_storage_bindings : owns
dataset_definitions -- tenant_storage_bindings : binds
encryption_profiles -- data_classifications : default encryption
key_rotation_policies -- encryption_profiles : rotates
retention_policies -- data_classifications : default retention
residency_policies -- dataset_placements : constrains
replication_policies -- dataset_placements : replicates
consistency_policies -- dataset_placements : consistency
dataset_definitions -- data_access_policies : protected by
storage_backend_regions -- store_health_checks : checked by
dataset_definitions -- storage_integrity_policies : verified by

package "Physical Indexes and Access Patterns" {
entity "INDEXES · storage_backends" as idxset_storage_backends <<INDEX_SET>> {
  PK pk_storage_backends : (id) UNIQUE BTREE
  UK uk_storage_backends_code : (code) UNIQUE BTREE
  IX ix_storage_backends_type_state : (backend_type, state) BTREE
}

storage_backends .. idxset_storage_backends : indexed by

entity "INDEXES · storage_backend_regions" as idxset_storage_backend_regions <<INDEX_SET>> {
  PK pk_storage_backend_regions : (id) UNIQUE BTREE
  UK uk_storage_backend_regions_backend_region : (storage_backend_id, region_code) UNIQUE BTREE
  IX ix_storage_backend_regions_country : (country_code, state) BTREE
}

storage_backend_regions .. idxset_storage_backend_regions : indexed by

entity "INDEXES · storage_capabilities" as idxset_storage_capabilities <<INDEX_SET>> {
  PK pk_storage_capabilities : (id) UNIQUE BTREE
  UK uk_storage_capabilities_backend_code : (storage_backend_id, capability_code, capability_version) UNIQUE BTREE
}

storage_capabilities .. idxset_storage_capabilities : indexed by

entity "INDEXES · data_classifications" as idxset_data_classifications <<INDEX_SET>> {
  PK pk_data_classifications : (id) UNIQUE BTREE
  UK uk_data_classifications_code : (code) UNIQUE BTREE
  IX ix_data_classifications_sensitivity : (sensitivity_level, contains_phi) BTREE
}

data_classifications .. idxset_data_classifications : indexed by

entity "INDEXES · dataset_definitions" as idxset_dataset_definitions <<INDEX_SET>> {
  PK pk_dataset_definitions : (id) UNIQUE BTREE
  UK uk_dataset_definitions_code : (code) UNIQUE BTREE
  IX ix_dataset_definitions_owner_state : (owning_module_code, lifecycle_state) BTREE
}

dataset_definitions .. idxset_dataset_definitions : indexed by

entity "INDEXES · dataset_versions" as idxset_dataset_versions <<INDEX_SET>> {
  PK pk_dataset_versions : (id) UNIQUE BTREE
  UK uk_dataset_versions_dataset_version : (dataset_definition_id, version) UNIQUE BTREE
  IX ix_dataset_versions_effective : (dataset_definition_id, effective_from DESC) BTREE
}

dataset_versions .. idxset_dataset_versions : indexed by

entity "INDEXES · collection_definitions" as idxset_collection_definitions <<INDEX_SET>> {
  PK pk_collection_definitions : (id) UNIQUE BTREE
  UK uk_collection_definitions_backend_name : (storage_backend_id, logical_name) UNIQUE BTREE
  IX ix_collection_definitions_dataset : (dataset_definition_id, lifecycle_state) BTREE
