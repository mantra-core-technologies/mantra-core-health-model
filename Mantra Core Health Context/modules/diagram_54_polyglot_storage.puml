}

dataset_placements .. idxset_dataset_placements : indexed by

entity "INDEXES · tenant_storage_bindings" as idxset_tenant_storage_bindings <<INDEX_SET>> {
  PK pk_tenant_storage_bindings : (id) UNIQUE BTREE
  UK uk_tenant_storage_bindings_tenant_dataset : (tenant_id, dataset_definition_id) UNIQUE BTREE
  IX ix_tenant_storage_bindings_state : (tenant_id, state) BTREE
}

tenant_storage_bindings .. idxset_tenant_storage_bindings : indexed by

entity "INDEXES · encryption_profiles" as idxset_encryption_profiles <<INDEX_SET>> {
  PK pk_encryption_profiles : (id) UNIQUE BTREE
  UK uk_encryption_profiles_code : (code) UNIQUE BTREE
  IX ix_encryption_profiles_provider_state : (key_management_provider, state) BTREE
}

encryption_profiles .. idxset_encryption_profiles : indexed by

entity "INDEXES · key_rotation_policies" as idxset_key_rotation_policies <<INDEX_SET>> {
  PK pk_key_rotation_policies : (id) UNIQUE BTREE
  UK uk_key_rotation_policies_code : (code) UNIQUE BTREE
}

key_rotation_policies .. idxset_key_rotation_policies : indexed by

entity "INDEXES · retention_policies" as idxset_retention_policies <<INDEX_SET>> {
  PK pk_retention_policies : (id) UNIQUE BTREE
  UK uk_retention_policies_code : (code) UNIQUE BTREE
  IX ix_retention_policies_jurisdiction : (jurisdiction_code, state) BTREE
}

retention_policies .. idxset_retention_policies : indexed by

entity "INDEXES · replication_policies" as idxset_replication_policies <<INDEX_SET>> {
  PK pk_replication_policies : (id) UNIQUE BTREE
  UK uk_replication_policies_code : (code) UNIQUE BTREE
}

replication_policies .. idxset_replication_policies : indexed by

entity "INDEXES · consistency_policies" as idxset_consistency_policies <<INDEX_SET>> {
  PK pk_consistency_policies : (id) UNIQUE BTREE
  UK uk_consistency_policies_code : (code) UNIQUE BTREE
}

consistency_policies .. idxset_consistency_policies : indexed by

entity "INDEXES · residency_policies" as idxset_residency_policies <<INDEX_SET>> {
  PK pk_residency_policies : (id) UNIQUE BTREE
  UK uk_residency_policies_code : (code) UNIQUE BTREE
  GIN gin_residency_policies_allowed_countries : (allowed_country_codes) GIN
}

residency_policies .. idxset_residency_policies : indexed by

entity "INDEXES · data_access_policies" as idxset_data_access_policies <<INDEX_SET>> {
  PK pk_data_access_policies : (id) UNIQUE BTREE
  UK uk_data_access_policies_dataset_purpose_principal : (dataset_definition_id, purpose_of_use_code, principal_type) UNIQUE BTREE
  GIN gin_data_access_policies_fields : (field_policy_json) GIN jsonb_path_ops
}

data_access_policies .. idxset_data_access_policies : indexed by

entity "INDEXES · store_health_checks" as idxset_store_health_checks <<INDEX_SET>> {
  PK pk_store_health_checks : (id) UNIQUE BTREE
  IX ix_store_health_checks_region_time : (storage_backend_region_id, checked_at DESC) BTREE
  BRIN brin_store_health_checks_checked_at : (checked_at) BRIN
}

store_health_checks .. idxset_store_health_checks : indexed by

entity "INDEXES · storage_cost_snapshots" as idxset_storage_cost_snapshots <<INDEX_SET>> {
  PK pk_storage_cost_snapshots : (id) UNIQUE BTREE
  UK uk_storage_cost_snapshots_scope_period : (storage_backend_region_id, tenant_id, dataset_definition_id, period_start, period_end) UNIQUE BTREE
  IX ix_storage_cost_snapshots_tenant_period : (tenant_id, period_end DESC) BTREE
}

storage_cost_snapshots .. idxset_storage_cost_snapshots : indexed by

entity "INDEXES · storage_integrity_policies" as idxset_storage_integrity_policies <<INDEX_SET>> {
  PK pk_storage_integrity_policies : (id) UNIQUE BTREE
  UK uk_storage_integrity_policies_dataset : (dataset_definition_id) UNIQUE BTREE
}

storage_integrity_policies .. idxset_storage_integrity_policies : indexed by

}


note as INDEX_POLICY_polyglot_storage
  INDEX AND ACCESS-PATTERN POLICY
  - Metadata indexes are PostgreSQL BTREE/GIN because governance records require transactions and auditability.
  - A placement is valid only when residency, encryption, retention and tenant isolation policies are simultaneously satisfied.
  - No application writes directly to a backend that lacks an active tenant_storage_binding.
end note

@enduml
