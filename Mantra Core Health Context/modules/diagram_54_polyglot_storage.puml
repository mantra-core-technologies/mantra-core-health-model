@startuml SALUD_Module_54_polyglot_storage
title Module 54 — Polyglot Storage Governance and Data Placement\n(control plane: PostgreSQL metadata)
skinparam shadowing false
skinparam linetype ortho
skinparam packageStyle rectangle
hide circle

note as BIZ_polyglot_storage
  BUSINESS PURPOSE
  Defines where each dataset may live, which store is canonical, how tenants are isolated, and which encryption, residency, retention, replication and consistency rules apply.
  This module is the control plane. It does not move clinical or financial sources of truth away from PostgreSQL.
end note

entity "directory.tenants" as directory_tenants <<REFERENCE_ONLY>> {
  * id : uuid <<PK>>
}

entity "common.files" as common_files <<REFERENCE_ONLY>> {
  * id : uuid <<PK>>
}

entity "iam.users" as iam_users <<REFERENCE_ONLY>> {
  * id : uuid <<PK>>
}

entity "system_ops.retention_policies" as system_ops_retention_policies <<REFERENCE_ONLY>> {
  * id : uuid <<PK>>
}

entity storage_backends <<CONTROL_PLANE>> {
  * id : uuid <<PK>>
  --
  * code : varchar
  * name : varchar
  * backend_type : varchar
  * provider_code : varchar
  * control_plane_endpoint : varchar
  * supports_transactions : boolean
  * supports_ttl : boolean
  * supports_encryption : boolean
  * supports_versioning : boolean
  * supports_worm : boolean
  * supports_vector_search : boolean
  * supports_full_text : boolean
  * state : varchar
  * created_at : timestamptz
  * updated_at : timestamptz
