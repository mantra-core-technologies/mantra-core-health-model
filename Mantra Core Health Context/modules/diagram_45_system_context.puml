note as BIZ_diagram_45_system_context
  BUSINESS PURPOSE
  Provides versioned system context for agents, modules and workflows, and
  database-driven enumerations resolved from governed terminology value sets.
  Consumers receive reproducible context instead of ad-hoc JSON or hard-coded lists.
end note

entity system_contexts {
  * id : uuid <<PK>>
  --
  * code : varchar <<UK>>
  * name : varchar
    description : text
  * context_type_concept_id : uuid <<FK>>
  * scope_type_concept_id : uuid <<FK>>
    tenant_id : uuid <<FK>>
    country_concept_id : uuid <<FK>>
    locale_concept_id : uuid <<FK>>
    current_version_id : uuid <<FK>>
    refresh_policy_concept_id : uuid <<FK>>
  * status_concept_id : uuid <<FK>>
  * created_at : timestamptz
  * updated_at : timestamptz
    created_by_user_id : uuid <<FK>>
    updated_by_user_id : uuid <<FK>>
  * row_version : integer
}

entity system_context_refresh_runs <<LOG>> {
  * id : uuid <<PK>>
  --
  * system_context_id : uuid <<FK>>
  * idempotency_key : varchar <<UK>>
  * trigger_concept_id : uuid <<FK>>
  * status_concept_id : uuid <<FK>>
  * started_at : timestamptz
    finished_at : timestamptz
    input_count : integer
    output_content_hash : varchar
    error_summary : text
  * recorded_at : timestamptz
    recorded_by_user_id : uuid <<FK>>
}

entity system_context_versions <<VERSIONED>> {
  * id : uuid <<PK>>
  --
  * system_context_id : uuid <<FK>>
  * version_number : integer
    refresh_run_id : uuid <<FK>>
  * schema_version : varchar
  * context_json : jsonb
  * content_hash : varchar
