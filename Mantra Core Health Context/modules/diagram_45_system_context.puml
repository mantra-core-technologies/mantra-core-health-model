}

entity system_context_inputs <<IMMUTABLE>> {
  * id : uuid <<PK>>
  --
  * system_context_version_id : uuid <<FK>>
  * source_type_concept_id : uuid <<FK>>
  * source_schema_name : varchar
  * source_entity_name : varchar
