note as MIGRATION_diagram_14_practice
  MIGRATION FROM THE PREVIOUS MODEL
  practices remains the stable financial/operational root. consulting_rooms
  becomes care_spaces. practice_practitioners becomes
  practitioner_role_assignments. This preserves practice_id references while
  allowing hospitals, nursing units, departments, beds and mobile services.
  Hosted diagnostic units/pharmacies are linked through organization_affiliations;
  they do not become informal subrecords of the host practice.
end note


package "Physical Indexes" {
entity "INDEXES · inventory_items" as idxset_inventory_items <<INDEX_SET>> {
  PK pk_inventory_items : (id) UNIQUE BTREE
  IX ix_inventory_items_practice_id : (practice_id) BTREE
  IX ix_inventory_items_product_concept_id : (product_concept_id) BTREE
  IX ix_inventory_items_unit_concept_id : (unit_concept_id) BTREE
  IX ix_inventory_items_status_concept_id : (status_concept_id) BTREE
  IX ix_inventory_items_created_by_user_id : (created_by_user_id) BTREE
  IX ix_inventory_items_updated_by_user_id : (updated_by_user_id) BTREE
}

inventory_items .. idxset_inventory_items : indexed by

entity "INDEXES · inventory_movements" as idxset_inventory_movements <<INDEX_SET>> {
  PK pk_inventory_movements : (id) UNIQUE BTREE
  IX ix_inventory_movements_inventory_item_id : (inventory_item_id) BTREE
  IX ix_inventory_movements_movement_type_concept_id : (movement_type_concept_id) BTREE
  IX ix_inventory_movements_recorded_by_user_id : (recorded_by_user_id) BTREE
  BRIN brin_inventory_movements_recorded_at : (recorded_at) BRIN pages_per_range=128
}

inventory_movements .. idxset_inventory_movements : indexed by

entity "INDEXES · practices" as idxset_practices <<INDEX_SET>> {
  PK pk_practices : (id) UNIQUE BTREE
