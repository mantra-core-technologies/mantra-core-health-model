@startuml SALUD_Module_07_consent
title Module 07 — Privacy Directives, Legal Bases and Consent Evidence\n(schema: consent)
skinparam shadowing false
skinparam linetype ortho
skinparam packageStyle rectangle
hide circle

note as BIZ
  BUSINESS PURPOSE
  Separates legal authority for processing from patient consent, HIPAA-style
  authorizations, treatment informed consent, privacy restrictions and objections.
  Consent is never treated as the universal basis for treatment, payment, operations
  or every use of health data. Every decision is jurisdiction-, purpose- and
  version-aware and retains reproducible evidence.
end note

entity processing_purposes {
  * id : uuid <<PK>>
  --
  * code : varchar <<UK>>
  * name : varchar
  * purpose_category_concept_id : uuid <<FK>>
    description : text
    purpose_of_use_concept_id : uuid <<FK>>
    default_retention_class_concept_id : uuid <<FK>>
  * status_concept_id : uuid <<FK>>
  * created_at : timestamptz
  * updated_at : timestamptz
    created_by_user_id : uuid <<FK>>
    updated_by_user_id : uuid <<FK>>
  * row_version : integer
}

entity processing_legal_bases <<VERSIONED>> {
  * id : uuid <<PK>>
  --
  * tenant_id : uuid <<FK>>
  * processing_purpose_id : uuid <<FK>>
  * jurisdiction_concept_id : uuid <<FK>>
  * general_legal_basis_concept_id : uuid <<FK>>
    special_category_condition_concept_id : uuid <<FK>>
    policy_version : varchar
    legal_reference_uri : text
  * valid_from : timestamptz
    valid_to : timestamptz
  * status_concept_id : uuid <<FK>>
  * created_at : timestamptz
  * updated_at : timestamptz
    created_by_user_id : uuid <<FK>>
    updated_by_user_id : uuid <<FK>>
  * row_version : integer
}

entity consents <<FHIR_CONSENT_DIRECTIVE>> {
  * id : uuid <<PK>>
  --
  * patient_profile_id : uuid <<FK>>
