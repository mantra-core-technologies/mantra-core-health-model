note as BIZ_diagram_06_authz
  BUSINESS PURPOSE
  Fine-grained control of who can do what, down to the individual field
  and the individual patient record. Combines role-based permissions,
  per-person exceptions and attribute rules to enforce least-privilege
  access.
end note

entity permission_categories {
  * id : uuid <<PK>>
  --
  * code : varchar <<UK>>
  * name : varchar
    description : text
    ordinal : integer
  * created_at : timestamptz
  * updated_at : timestamptz
    created_by_user_id : uuid <<FK>>
    updated_by_user_id : uuid <<FK>>
  * row_version : integer
}
entity permissions {
  * id : uuid <<PK>>
  --
  * code : varchar <<UK>>
    category_id : uuid <<FK>>
  * name : varchar
  * resource : varchar
  * action_concept_id : uuid <<FK>>
    default_scope_concept_id : uuid <<FK>>
    is_field_level : boolean
    is_dangerous : boolean
  * state_concept_id : uuid <<FK>>
  * created_at : timestamptz
  * updated_at : timestamptz
    created_by_user_id : uuid <<FK>>
    updated_by_user_id : uuid <<FK>>
  * row_version : integer
  ' + v4.0.1
  * is_role_restricted : boolean
    required_role_code : varchar
  * allow_direct_user_grant : boolean
  ' + v4.2.78 (gobierno de accesos): metadatos de cada permiso. Un permiso es un ATOMO `modulo.recurso.accion[.campo]`.
  ' sensibilidad: authz:SENSITIVITY_LOW|MEDIUM|HIGH|CRITICAL. requires_reason / requires_step_up / approval_mode son las
  ' OBLIGACIONES que el motor exige al ejercerlo (motivo, MFA fresco, cuatro ojos). Los 15 codigos antiguos quedan como alias.
    sensitivity_concept_id : uuid <<FK>>
  * requires_reason : boolean <<DEFAULT_FALSE>>
  * requires_step_up : boolean <<DEFAULT_FALSE>>
    approval_mode_concept_id : uuid <<FK>>
    purpose_of_use_concept_id : uuid <<FK>>
    legal_basis_concept_id : uuid <<FK>>
  * touches_clinical_data : boolean <<DEFAULT_FALSE>>
  * support_assignable : boolean <<DEFAULT_FALSE>>
}
