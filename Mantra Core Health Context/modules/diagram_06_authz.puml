  * id : uuid <<PK>>
  --
  * tenant_id : uuid <<FK>>
  * patient_profile_id : uuid <<FK>>
  * practitioner_profile_id : uuid <<FK>>
  * relationship_type_concept_id : uuid <<FK>>
  * status_concept_id : uuid <<FK>>
    purpose_concept_id : uuid <<FK>>
  * valid_from : timestamptz
    valid_to : timestamptz
