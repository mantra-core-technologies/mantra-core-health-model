catalog_process_steps .. idxset_catalog_process_steps : indexed by

entity catalog_process_step_operations {
  * id : uuid <<PK>>
  * step_id : uuid <<FK>>
  * operation_id : uuid <<FK>>
  * ordinal : integer
  * created_at : timestamptz
  * updated_at : timestamptz
    created_by_user_id : uuid <<FK>>
    updated_by_user_id : uuid <<FK>>
  * row_version : integer
}

entity "INDEXES · catalog_process_step_operations" as idxset_catalog_process_step_operations <<INDEX_SET>> {
  PK pk_catalog_process_step_operations : (id) UNIQUE BTREE
  UX ux_data_catalog_process_step_operations_pair : (step_id, operation_id) UNIQUE BTREE
  IX ix_data_catalog_process_step_operations_step_id : (step_id) BTREE
  IX ix_data_catalog_process_step_operations_operation_id : (operation_id) BTREE
}
catalog_process_step_operations .. idxset_catalog_process_step_operations : indexed by

catalog_scan_runs ||--o{ catalog_objects
catalog_scan_runs ||--o{ catalog_columns
catalog_objects ||--o{ catalog_columns
catalog_scan_runs ||--o{ catalog_change_events
catalog_objects ||--o{ catalog_change_events
catalog_columns ||--o{ catalog_change_events
catalog_objects ||--o{ catalog_annotations
catalog_columns ||--o{ catalog_annotations
catalog_annotations ||--o{ catalog_annotation_revisions
catalog_annotations ||--o{ catalog_review_decisions
catalog_objects ||--o{ catalog_evidence_items
catalog_columns ||--o{ catalog_evidence_items
' Las FK de las cuatro tablas del mapa operaciones <-> datos van con la columna como
' etiqueta: `gen_ddl.resolve_fk_from_diagram` resuelve el destino por esa etiqueta, sin
' depender de una nota FK de la boveda.
catalog_operation_impacts }o--|| catalog_operations : operation_id
catalog_operation_impacts }o--|| catalog_objects : object_id
catalog_operation_impacts }o--o| catalog_columns : column_id
catalog_process_steps }o--|| catalog_processes : process_id
catalog_process_step_operations }o--|| catalog_process_steps : step_id
catalog_process_step_operations }o--|| catalog_operations : operation_id
@enduml
