entity "INDEXES · catalog_process_steps" as idxset_catalog_process_steps <<INDEX_SET>> {
  PK pk_catalog_process_steps : (id) UNIQUE BTREE
  UX ux_data_catalog_process_steps_ordinal : (process_id, ordinal) UNIQUE BTREE
