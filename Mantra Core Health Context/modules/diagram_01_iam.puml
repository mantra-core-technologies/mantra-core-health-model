note as BIZ_diagram_01_iam
  BUSINESS PURPOSE
  Manages login accounts, credentials, MFA, devices and sessions. A user
  record is an authenticating account, not a person, patient or practitioner.
  Human identity and role profiles are modeled separately in Module 05 and
  linked optionally so patients and external professionals can exist without
  portal credentials.
end note

entity users <<ACCOUNT>> {
  * id : uuid <<PK>>
  --
  * status_concept_id : uuid <<FK>>
  * display_name : varchar
    preferred_language_concept_id : uuid <<FK>>
    time_zone : varchar
    residence_country_concept_id : uuid <<FK>>
    data_residency_region_concept_id : uuid <<FK>>
    email_verified : boolean
    phone_verified : boolean
    mfa_status_concept_id : uuid <<FK>>
    legal_basis_concept_id : uuid <<FK>>
    privacy_accepted_at : timestamptz
    privacy_policy_version : varchar
    anonymized_at : timestamptz
    last_login_at : timestamptz
  * created_at : timestamptz
  * updated_at : timestamptz
    created_by_user_id : uuid <<FK>>
    updated_by_user_id : uuid <<FK>>
  * row_version : integer
  ' + v4.0.8 (ALOVIDA C-18): la cuenta creada por registro asistido queda obligada
  ' a fijar su propia contraseña en el primer ingreso.
    must_change_password : boolean
}

' + v4.0.8 (ALOVIDA C-18 / CAN-IDENT) — Registro asistido de pacientes.
' Un clínico crea la cuenta de alguien que no puede hacerlo por sí mismo. El
' creador NUNCA conoce la contraseña definitiva: se emite un token de activación
' de un solo uso del que se persiste SOLO el hash, con caducidad, y el titular fija
' su credencial al activarla.
entity account_activations {
  * id : uuid <<PK>>
  --
  * user_id : uuid <<FK>>
  ' SHA-256 (hex) del token; el token en claro no se guarda en ninguna parte.
  * token_hash : varchar <<UK>>
  * state_concept_id : uuid <<FK>>
  ' Motivo del registro asistido, exigido por C-18 para la trazabilidad.
    reason : varchar
  ' Representación legal que ampara el registro, si la hay. El nombre de la
  ' columna no resuelve el destino por convención, así que
  ' authz.patient_legal_representations se declara en su nota del vault.
    legal_representation_id : uuid <<FK>>
    legal_representative_user_id : uuid <<FK>>
  * expires_at : timestamptz
    consumed_at : timestamptz
  * created_at : timestamptz
  * updated_at : timestamptz
  ' El clínico o administrativo que creó la cuenta.
    created_by_user_id : uuid <<FK>>
    updated_by_user_id : uuid <<FK>>
  * row_version : integer
}

entity "INDEXES · account_activations" as idxset_account_activations <<INDEX_SET>> {
  PK pk_account_activations : (id) UNIQUE BTREE
  UX ux_account_activations_token_hash : (token_hash) UNIQUE BTREE
  IX ix_account_activations_user : (user_id, state_concept_id) BTREE
}
account_activations .. idxset_account_activations : indexed by

' + v4.0.9 (ALOVIDA CAN-IDENT) — Verificación del correo del auto-registro.
' El paciente que se registra por sí mismo con su documento elige su contraseña,
' así que la cuenta nace ACTIVA. El correo es OPCIONAL y verificarlo NO condiciona
' el acceso: si lo aporta se emite un token de un solo uso del que se persiste
' SOLO el hash, con caducidad.
entity email_verifications {
  * id : uuid <<PK>>
  --
  * user_id : uuid <<FK>>
  ' Dirección que se está verificando; se guarda acá porque la verificación
  ' prueba ESA dirección, aunque después el usuario cambie la suya.
  * email : varchar
  ' SHA-256 (hex) del token; el token en claro no se guarda en ninguna parte.
  * token_hash : varchar <<UK>>
  * state_concept_id : uuid <<FK>>
  * expires_at : timestamptz
  ' Sella el uso único: un token consumido no vuelve a servir.
    consumed_at : timestamptz
  * created_at : timestamptz
  * updated_at : timestamptz
    created_by_user_id : uuid <<FK>>
    updated_by_user_id : uuid <<FK>>
  * row_version : integer
}

entity "INDEXES · email_verifications" as idxset_email_verifications <<INDEX_SET>> {
  PK pk_email_verifications : (id) UNIQUE BTREE
  UX ux_email_verifications_token_hash : (token_hash) UNIQUE BTREE
  IX ix_email_verifications_user : (user_id, state_concept_id) BTREE
}
email_verifications .. idxset_email_verifications : indexed by

' + v4.0.9 (ALOVIDA CAN-IDENT) — Restablecimiento de contraseña.
' Comparte forma con email_verifications pero NO significado, y por eso no
' comparte tabla: consumir un token de verificación marca un correo como probado;
' consumir uno de restablecimiento cambia una credencial y mata todas las
' sesiones. En una sola tabla, un token emitido para lo primero serviría para lo
' segundo — una escalada de privilegio con la forma de un ahorro de tabla.
entity password_resets {
  * id : uuid <<PK>>
  --
  * user_id : uuid <<FK>>
  ' Identificador con el que se pidió el restablecimiento: correo o documento,
  ' según por cuál se autentique el titular.
  * external_subject : varchar
  ' SHA-256 (hex) del token; el token en claro no se guarda en ninguna parte.
  * token_hash : varchar <<UK>>
  * state_concept_id : uuid <<FK>>
  * expires_at : timestamptz
    consumed_at : timestamptz
  ' Origen de la solicitud, para auditar abuso del formulario público.
    requested_ip : varchar
  * created_at : timestamptz
  * updated_at : timestamptz
    created_by_user_id : uuid <<FK>>
    updated_by_user_id : uuid <<FK>>
  * row_version : integer
}

entity "INDEXES · password_resets" as idxset_password_resets <<INDEX_SET>> {
  PK pk_password_resets : (id) UNIQUE BTREE
  UX ux_password_resets_token_hash : (token_hash) UNIQUE BTREE
  IX ix_password_resets_user_state : (user_id, state_concept_id) BTREE
}
password_resets .. idxset_password_resets : indexed by

